<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_payslip_dz_document">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="slip">
            <t t-call="web.external_layout">
                <div class="page">

                    <!-- ══ ENTÊTE ══════════════════════════════════════════ -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>BULLETIN DE PAIE</strong><br/>
                            <span t-field="slip.company_id.name"/><br/>
                            <span t-field="slip.company_id.street"/><br/>
                            <span t-field="slip.company_id.city"/>
                        </div>
                        <div class="col-6 text-end">
                            <strong>Période :</strong>
                            <span t-field="slip.date_from" t-options='{"format": "MMMM yyyy"}'/><br/>
                            <strong>N° :</strong> <span t-field="slip.number"/><br/>
                            <strong>Type :</strong> <span t-field="slip.type_bulletin"/>
                        </div>
                    </div>

                    <!-- ══ INFORMATIONS SALARIÉ ════════════════════════════ -->
                    <table class="table table-sm table-bordered mb-3">
                        <thead class="table-secondary">
                            <tr>
                                <th>Nom Prénom</th>
                                <th>Matricule</th>
                                <th>Grade</th>
                                <th>Catégorie</th>
                                <th>Fonction</th>
                                <th>N° CNAS</th>
                                <th>N° Compte</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong><span t-field="slip.employee_id.name"/></strong></td>
                                <td><span t-field="slip.contract_id.matricule"/></td>
                                <td><span t-field="slip.contract_id.grade"/></td>
                                <td><span t-field="slip.contract_id.categorie_professionnelle"/></td>
                                <td><span t-field="slip.contract_id.poste_occupe"/></td>
                                <td><span t-field="slip.contract_id.numero_cnas"/></td>
                                <td><span t-field="slip.contract_id.numero_compte_bancaire"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Situation familiale et taux IRG -->
                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Situation familiale :</strong>
                            <span t-field="slip.employee_id.situation_familiale"/>
                        </div>
                        <div class="col-4">
                            <strong>Nombre d'enfants :</strong>
                            <span t-field="slip.employee_id.nombre_enfants"/>
                        </div>
                        <div class="col-4">
                            <strong>Taux IEP :</strong>
                            <t t-set="anciennete" t-value="slip.compute_anciennete()"/>
                            <span t-esc="anciennete"/> ans
                        </div>
                    </div>

                    <!-- ══ RUBRIQUES DE PAIE ═══════════════════════════════ -->
                    <table class="table table-sm table-bordered mb-3">
                        <thead class="table-dark">
                            <tr>
                                <th>Code</th>
                                <th>Désignation</th>
                                <th class="text-end">Base</th>
                                <th class="text-end">Taux (%)</th>
                                <th class="text-end">Montant (DA)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- GAINS -->
                            <tr class="table-light">
                                <td colspan="5"><strong>GAINS</strong></td>
                            </tr>
                            <t t-foreach="slip.line_ids.filtered(lambda l: l.appears_on_payslip and l.total > 0 and l.category_id.code not in ['COTISATIONS', 'CHARGES_PAT', 'NET'])" t-as="line">
                                <tr>
                                    <td><span t-field="line.code"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end">
                                        <span t-esc="'{:,.2f}'.format(line.amount)"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(line.rate)"/>
                                    </td>
                                    <td class="text-end">
                                        <strong><span t-esc="'{:,.2f}'.format(line.total)"/></strong>
                                    </td>
                                </tr>
                            </t>

                            <!-- RETENUES -->
                            <tr class="table-light">
                                <td colspan="5"><strong>RETENUES</strong></td>
                            </tr>
                            <t t-foreach="slip.line_ids.filtered(lambda l: l.appears_on_payslip and l.total &lt; 0)" t-as="line">
                                <tr>
                                    <td><span t-field="line.code"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end">
                                        <span t-esc="'{:,.2f}'.format(abs(line.amount))"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(line.rate)"/>
                                    </td>
                                    <td class="text-end text-danger">
                                        <strong><span t-esc="'{:,.2f}'.format(line.total)"/></strong>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- ══ RÉCAPITULATIF ═══════════════════════════════════ -->
                    <div class="row">
                        <div class="col-6">
                            <!-- Charges patronales (info) -->
                            <table class="table table-sm table-bordered">
                                <thead class="table-secondary">
                                    <tr><th colspan="2">Charges Patronales (information)</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>CNAS Patronale (26%)</td>
                                        <td class="text-end">
                                            <span t-esc="'{:,.2f}'.format(slip.cotisation_cnas_patronale)"/> DA
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Allocations Familiales</td>
                                        <td class="text-end">
                                            <span t-esc="'{:,.2f}'.format(slip.compute_allocations_familiales())"/> DA
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-6">
                            <!-- Totaux nets -->
                            <table class="table table-sm table-bordered">
                                <thead class="table-secondary">
                                    <tr><th colspan="2">Récapitulatif</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Salaire Brut</td>
                                        <td class="text-end">
                                            <span t-esc="'{:,.2f}'.format(slip.montant_brut)"/> DA
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>CNAS Salariale (9%)</td>
                                        <td class="text-end text-danger">
                                            - <span t-esc="'{:,.2f}'.format(slip.cotisation_cnas_salariale)"/> DA
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>IRG</td>
                                        <td class="text-end text-danger">
                                            - <span t-esc="'{:,.2f}'.format(slip.montant_irg)"/> DA
                                        </td>
                                    </tr>
                                    <tr class="table-success">
                                        <td><strong>NET À PAYER</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-esc="'{:,.2f}'.format(slip.net_a_payer)"/> DA
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ══ PIED DE PAGE ════════════════════════════════════ -->
                    <div class="row mt-3">
                        <div class="col-6">
                            <strong>Mode de règlement :</strong>
                            <span t-field="slip.moyen_paiement"/>
                            <t t-if="slip.contract_id.numero_compte_bancaire">
                                — <span t-field="slip.contract_id.numero_compte_bancaire"/>
                            </t>
                        </div>
                        <div class="col-6 text-end">
                            <br/>
                            <strong>Signature employeur</strong>
                            <br/><br/><br/>
                            ___________________________
                        </div>
                    </div>

                    <!-- Mention légale -->
                    <div class="mt-3 text-muted" style="font-size:9px">
                        Bulletin de paie à conserver sans limitation de durée. —
                        Conformément à la législation algérienne du travail.
                    </div>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
