<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Taux légaux : form ──────────────────────────────────────────── -->
    <record id="l10n_dz_hr_payroll_rate_view_form" model="ir.ui.view">
        <field name="name">l10n.dz.hr.payroll.rate.form</field>
        <field name="model">l10n.dz.hr.payroll.rate</field>
        <field name="arch" type="xml">
            <form string="Taux Légaux Paie Algérienne">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Désignation..."/></h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="SMIG">
                            <field name="smig"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="CNAS" name="cnas">
                            <group>
                                <group string="Taux de cotisation">
                                    <field name="cnas_salarial_rate"/>
                                    <field name="cnas_patronal_rate"/>
                                    <field name="cnas_plafond"/>
                                </group>
                            </group>
                        </page>
                        <page string="IRG" name="irg">
                            <group>
                                <group string="Abattement">
                                    <field name="irg_abattement_rate"/>
                                    <field name="irg_abattement_min"/>
                                    <field name="irg_abattement_max"/>
                                </group>
                                <group string="Déductions famille">
                                    <field name="irg_deduction_conjoint"/>
                                    <field name="irg_deduction_enfant"/>
                                </group>
                            </group>
                            <separator string="Barème progressif IRG (annuel)"/>
                            <field name="irg_bracket_ids">
                                <list editable="bottom">
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                    <field name="rate"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="IEP" name="iep">
                            <group>
                                <field name="iep_rate_per_year"/>
                                <field name="iep_max_rate"/>
                            </group>
                        </page>
                        <page string="Indemnités" name="indemnites">
                            <group>
                                <group string="Indemnités forfaitaires">
                                    <field name="indemnite_transport"/>
                                    <field name="indemnite_panier"/>
                                </group>
                                <group string="Allocations familiales">
                                    <field name="allocation_familiale_rate"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Taux légaux : list ──────────────────────────────────────────── -->
    <record id="l10n_dz_hr_payroll_rate_view_list" model="ir.ui.view">
        <field name="name">l10n.dz.hr.payroll.rate.list</field>
        <field name="model">l10n.dz.hr.payroll.rate</field>
        <field name="arch" type="xml">
            <list string="Taux Légaux">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="smig"/>
                <field name="cnas_salarial_rate"/>
                <field name="cnas_patronal_rate"/>
                <field name="cnas_plafond"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────── -->
    <record id="action_l10n_dz_hr_payroll_rate" model="ir.actions.act_window">
        <field name="name">Taux Légaux Algériens</field>
        <field name="res_model">l10n.dz.hr.payroll.rate</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
