    <!-- SALAIRE BRUT (total affiché) -->
    <record id="rule_dz_brut" model="hr.salary.rule">
        <field name="name">Salaire Brut</field>
        <field name="code">BRUT</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="category_brut_dz"/>
        <field name="appears_on_payslip">True</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# BRUT = BASE_CNAS + BASE_IRG + PRIMES
result = categories.BASE_CNAS + categories.BASE_IRG + categories.PRIMES
        </field>
    </record>

    <!-- CNAS SALARIALE 9% — base = BASE_CNAS uniquement -->
    <record id="rule_dz_cnas_sal" model="hr.salary.rule">
        <field name="name">Cotisation CNAS Salariale (9%)</field>
        <field name="code">CNAS_SAL</field>
        <field name="sequence">110</field>
        <field name="category_id" ref="category_cotisations_dz"/>
        <field name="appears_on_payslip">True</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = -payslip.compute_cnas_salariale(categories.BASE_CNAS)
        </field>
    </record>

    <!-- IRG — base = BASE_CNAS + BASE_IRG - CNAS_SAL -->
    <record id="rule_dz_irg" model="hr.salary.rule">
        <field name="name">IRG (Impôt sur le Revenu Global)</field>
        <field name="code">IRG</field>
        <field name="sequence">120</field>
        <field name="category_id" ref="category_cotisations_dz"/>
        <field name="appears_on_payslip">True</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Base IRG = (BASE_CNAS + BASE_IRG) - CNAS salariale
base_imposable = categories.BASE_CNAS + categories.BASE_IRG + categories.COTISATIONS
result = -payslip.compute_irg(base_imposable)
        </field>
    </record>

