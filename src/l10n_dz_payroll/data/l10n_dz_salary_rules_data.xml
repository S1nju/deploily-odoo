            Command.link(ref('l10n_dz_payroll.rule_dz_interim')),
            Command.link(ref('l10n_dz_payroll.rule_dz_permanence')),
            Command.link(ref('l10n_dz_payroll.rule_dz_fonction')),
            Command.link(ref('l10n_dz_payroll.rule_dz_caisse')),
