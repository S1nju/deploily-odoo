<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Company form -->
    <record id="res_company_form_l10n_dz_info" model="ir.ui.view">
        <field name="name">res_company_form_l10n_dz_info</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_id']" position="after">
                <field name="commune_id"
                       string="Commune"
                       placeholder="Commune..."
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="rc"/>
                <field name="nif"/>
                <field name="nis"/>
                <field name="ai"/>
            </xpath>
        </field>
    </record>

    <!-- Partner form -->
    <record id="res_partner_form_l10n_dz_info" model="ir.ui.view">
        <field name="name">res_partner_form_l10n_dz_info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='zip']" position="before">
                <field name="commune_id"
                       string="Commune"
                       placeholder="Commune..."
                       class="o_address_state"
                       options="{'no_create': True}"
                       domain="[('state_id', '=', state_id)]"/>
            </xpath>
            <xpath expr="//field[@name='property_account_position_id']" position="after">
                <field name="rc"/>
                <field name="nif"/>
                <field name="nis"/>
                <field name="ai"/>
            </xpath>
        </field>
    </record>

    <!-- Employee private address -->
    <record id="hr_employee_form_l10n_dz_commune" model="ir.ui.view">
        <field name="name">hr_employee_form_l10n_dz_commune</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]//field[@name='private_state_id']" position="after">
                <field name="commune_id"
                       string="Commune"
                       placeholder="Commune..."
                       class="o_address_state"
                       options="{'no_create': True}"
                       domain="[('state_id', '=', private_state_id)]"/>
            </xpath>
        </field>
    </record>

</odoo>
