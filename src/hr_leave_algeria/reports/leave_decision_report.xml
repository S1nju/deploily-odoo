<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Leave Decision Report Action -->
    <record id="action_report_leave_decision" model="ir.actions.report">
      <field name="name">مقرر عطلة -  Décision de congé</field>
      <field name="model">hr.leave</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">hr_leave_algeria.report_leave_decision_document</field>
      <field name="report_file">hr_leave_algeria.report_leave_decision_document</field>
      <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
      <field name="binding_type">report</field>
      <field name="print_report_name">'مقرر عطلة - %s' % (object.employee_id.name)</field>
    </record>

    <!-- QWeb Report Template -->
    <template id="report_leave_decision_document">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <t t-call="web.external_layout">
            <div class="page" style="font-family: Arial, sans-serif; direction: rtl; text-align: right;">
              
              <!-- Header -->
              <div style="text-align: center; margin-bottom: 30px;">
                <h2 style="font-size: 18px; margin: 0;">مقرر عطلة</h2>
                <h3 style="font-size: 14px; margin: 10px 0;">TITRE DE CONGÉ</h3>
              </div>

              <!-- Main Content -->
              <div style="line-height: 2;">
                <!-- Part 1: Company Information -->
                <p>
                  السيد(ة) <span t-if="doc.company_id and doc.company_id.partner_id"><span t-esc="doc.company_id.partner_id.name or '…………………'"/></span>
                </p>
                <p>بصفته(ها) مسير(ة) الشركة ………………… ،الكائن مقرها</p>
                <p>…………………………………………………………………</p>
                
                <!-- Separator -->
                <p style="text-align: center; margin: 20px 0;">————————————————</p>

                <!-- Part 2: Employee as User -->
                <p style="font-weight: bold;">بصفته(ها) المستخدم</p>
                <p>السيد(ة): <span t-esc="doc.employee_id.name or '…………………'"/></p>
                <p>
                  المولود(ة) في: 
                  <t t-if="doc.employee_id and 'birthday' in doc.employee_id._fields and doc.employee_id.birthday">
                    <span t-esc="doc.employee_id.birthday"/>
                  </t>
                  <t t-else="">…………………</t>
                  بـ: …………………
                </p>
                <p>الساكن(ة) ب: …………………</p>
                <p>المنصب: 
                  <t t-if="doc.employee_id and doc.employee_id.job_id">
                    <span t-esc="doc.employee_id.job_id.name or '…………………'"/>
                  </t>
                  <t t-else="">…………………</t>
                </p>

                <!-- Separator -->
                <p style="text-align: center; margin: 20px 0;">————————————————</p>

                <!-- Part 3: Employee as Worker -->
                <p style="font-weight: bold;">بصفته(ها) الأجير(ة)</p>

                <!-- Leave Decision -->
                <p style="margin-top: 20px;">
                  تستفيد من عطلة سنوية من: 
                  <t t-if="doc.date_from">
                    <span t-esc="doc.date_from" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                  </t>
                  <t t-else="">………………</t>
                  إلى غاية: 
                  <t t-if="doc.date_to">
                    <span t-esc="doc.date_to" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                  </t>
                  <t t-else="">………………</t>
                </p>

                <p>لاستغلالها حسب ما يسمح به القانون</p>

                <!-- Signature Section -->
                <div style="margin-top: 50px;">
                  <p>
                    حرر ب: 
                    <t t-if="doc.company_id and doc.company_id.partner_id">
                      <span t-esc="doc.company_id.partner_id.city or '…………………'"/>
                    </t>
                    <t t-else="">…………………</t>
                    ، في: <span t-esc="time.strftime('%d/%m/%Y')"/>
                  </p>
                  
                  <!-- Signature Table -->
                  <table style="width: 100%; margin-top: 40px; border-collapse: collapse;">
                    <tr>
                      <td style="width: 50%; text-align: center; padding: 20px; border-top: 1px solid black;">
                        <p style="margin: 0;">خاتم وإمضاء المستخدم</p>
                      </td>
                      <td style="width: 50%; text-align: center; padding: 20px; border-top: 1px solid black;">
                        <p style="margin: 0;">خاتم وإمضاء الأجير</p>
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- Footer Info -->
                <div style="margin-top: 40px; font-size: 10px; border-top: 1px solid #ccc; padding-top: 10px;">
                  <p style="margin: 0;">
                    <t t-if="doc.company_id">
                      <span t-esc="doc.company_id.name"/>
                    </t>
                  </p>
                  <p style="margin: 0;">
                    معرف رقمي: 
                    <t t-if="doc.company_id and doc.company_id.vat">
                      <span t-esc="doc.company_id.vat"/>
                    </t>
                  </p>
                </div>
              </div>

            </div>
          </t>
        </t>
      </t>
    </template>
  </data>
</odoo>
