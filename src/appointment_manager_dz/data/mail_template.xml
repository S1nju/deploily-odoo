<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_appointment_confirmation" model="mail.template">
            <field name="name">Rendez-vous : Confirmation au client</field>
            <field name="model_id" ref="model_appointment_appointment"/>
            <field name="subject">✅ Votre rendez-vous est confirmé - {{object.name}}</field>
            <field name="email_to">{{object.client_email}}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f9f9f9; padding: 30px; border-radius: 10px;">

    <div style="background: linear-gradient(135deg, #667eea, #764ba2); padding: 30px; border-radius: 10px; text-align: center; margin-bottom: 25px;">
        <h1 style="color: white; margin: 0; font-size: 1.6rem;">✅ Rendez-vous confirmé</h1>
    </div>

    <div style="background: white; padding: 25px; border-radius: 10px; margin-bottom: 20px;">
        <p style="color: #555; font-size: 1rem;">Bonjour <strong>{{object.client_name}}</strong>,</p>
        <p style="color: #555; font-size: 1rem;">Votre demande de rendez-vous a bien été reçue et enregistrée.</p>

        <div style="background: #f0f4ff; border-left: 4px solid #667eea; padding: 20px; border-radius: 5px; margin: 20px 0;">
            <h3 style="color: #667eea; margin: 0 0 12px 0;">📋 Détails du rendez-vous</h3>
            <table style="width: 100%; border-collapse: collapse;">
                <tr>
                    <td style="padding: 6px 0; color: #888; width: 40%;">Référence :</td>
                    <td style="padding: 6px 0; color: #333; font-weight: bold;">{{object.name}}</td>
                </tr>
                <tr>
                    <td style="padding: 6px 0; color: #888;">Date :</td>
                    <td style="padding: 6px 0; color: #333; font-weight: bold;">{{object.date_appointment}}</td>
                </tr>
                <tr>
                    <td style="padding: 6px 0; color: #888;">Nom :</td>
                    <td style="padding: 6px 0; color: #333;">{{object.client_name}}</td>
                </tr>
                <tr>
                    <td style="padding: 6px 0; color: #888;">Email :</td>
                    <td style="padding: 6px 0; color: #333;">{{object.client_email}}</td>
                </tr>
                % if object.client_phone:
                <tr>
                    <td style="padding: 6px 0; color: #888;">Téléphone :</td>
                    <td style="padding: 6px 0; color: #333;">{{object.client_phone}}</td>
                </tr>
                % endif
                % if object.reason:
                <tr>
                    <td style="padding: 6px 0; color: #888; vertical-align: top;">Raison :</td>
                    <td style="padding: 6px 0; color: #333;">{{object.reason}}</td>
                </tr>
                % endif
            </table>
        </div>

        <p style="color: #555; font-size: 0.95rem;">
            Nous vous contacterons prochainement pour confirmer les détails.<br>
            Si vous avez des questions, n'hésitez pas à nous répondre à cet email.
        </p>
    </div>

    <div style="text-align: center; color: #aaa; font-size: 0.8rem; margin-top: 20px;">
        Ce message est envoyé automatiquement — merci de ne pas y répondre directement.
    </div>
</div>
            ]]></field>
        </record>

        <!-- Sequence for appointment reference -->
        <record id="seq_appointment" model="ir.sequence">
            <field name="name">Appointment Sequence</field>
            <field name="code">appointment.appointment</field>
            <field name="prefix">RDV/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
