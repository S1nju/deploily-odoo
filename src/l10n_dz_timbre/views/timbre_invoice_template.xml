<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_with_timbre" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@id='total']" position="after">
                <t t-if="o.currency_id.name == 'DZD' and o.is_cash_payment">
                    <div class="row justify-content-end">
                        <div class="col-auto">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="text-start">Timbre</td>
                                    <td class="text-end">
                                        <span class="text-nowrap" t-field="o.amount_timbre"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold">
                                    <td class="text-start">Montant avec Timbre (si en espèce)</td>
                                    <td class="text-end">
                                        <span class="text-nowrap" t-field="o.amount_total_timbre"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
