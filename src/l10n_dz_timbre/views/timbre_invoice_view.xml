<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_move_form_dz" model="ir.ui.view">
            <field name="name">account_move_form_dz</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='narration']" position="after">
                    <!-- Toggle: cash payment -->
                    <group invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')">
                        <field name="is_cash_payment" widget="boolean_toggle"/>
                    </group>
                    <!-- Timbre fields: only visible when cash payment is enabled -->
                    <group class="oe_subtotal_footer oe_right"
                           invisible="not is_cash_payment or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')">
                        <field name="amount_timbre" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_total_timbre" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
