<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_bulletin_paie_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">

                    <!-- ══ HEADER ══════════════════════════════════════════ -->
                    <div style="border: 2px solid #2c3e50; padding: 8px; margin-bottom: 8px; background: #f8f9fa;">
                        <table width="100%">
                            <tr>
                                <td width="50%" style="vertical-align:top;">
                                    <strong style="font-size:14px; color:#2c3e50;">
                                        BULLETIN DE PAIE
                                    </strong><br/>
                                    <span style="font-size:12px;">
                                        <t t-out="o.name"/>
                                    </span>
                                </td>
                                <td width="50%" style="text-align:right; vertical-align:top;">
                                    <strong>Période : </strong>
                                    <t t-out="dict(o._fields['mois'].selection).get(o.mois, '')"/>
                                    <t t-out="o.annee"/>
                                    <br/>
                                    <strong>Type : </strong>
                                    <t t-out="dict(o._fields['type_bulletin'].selection).get(o.type_bulletin, '')"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ══ IDENTIFICATION EMPLOYÉ ════════════════════════ -->
                    <table width="100%" style="border-collapse: collapse; margin-bottom:6px;">
                        <tr style="background:#2c3e50; color:white;">
                            <th colspan="4" style="padding:4px 8px; text-align:center;">
                                IDENTIFICATION DE L'EMPLOYÉ
                            </th>
                        </tr>
                        <tr style="background:#ecf0f1;">
                            <td style="padding:3px 6px; border:1px solid #bdc3c7; width:25%;"><strong>Nom &amp; Prénom</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7; width:25%;"><t t-out="o.employe_id.name"/></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7; width:25%;"><strong>Matricule</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.matricule or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Grade</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.grade or ''"/></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Fonction</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.fonction or ''"/></td>
                        </tr>
                        <tr style="background:#ecf0f1;">
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Catégorie</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;">
                                <t t-out="dict(o._fields['categorie'].selection).get(o.categorie, '') if o.categorie else ''"/>
                            </td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Direction</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.direction_id.name if o.direction_id else ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Sit. Familiale</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;">
                                <t t-out="dict(o._fields['situation_familiale'].selection).get(o.situation_familiale, '') if o.situation_familiale else ''"/>
                            </td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Nbre Enfants</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.nbre_enfants"/></td>
                        </tr>
                        <tr style="background:#ecf0f1;">
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>N° CNAS</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.num_cnas or ''"/></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>N° Sécurité Sociale</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.num_securite_sociale or ''"/></td>
                        </tr>
                        <tr>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Taux IEP</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="'%.2f %%' % o.taux_iep"/></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Moyen de Paiement</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;">
                                <t t-out="dict(o._fields['moyen_paiement'].selection).get(o.moyen_paiement, '') if o.moyen_paiement else ''"/>
                            </td>
                        </tr>
                        <tr style="background:#ecf0f1;">
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Jours Ouvrables</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.jours_ouvrables"/></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><strong>Jours Travaillés</strong></td>
                            <td style="padding:3px 6px; border:1px solid #bdc3c7;"><t t-out="o.jours_travailles"/></td>
                        </tr>
                    </table>

                    <!-- ══ GAINS / RETENUES ══════════════════════════════ -->
                    <table width="100%" style="border-collapse:collapse; margin-bottom:6px;">
                        <tr style="background:#2c3e50; color:white;">
                            <th style="padding:4px 8px; width:60%;">DÉSIGNATION</th>
                            <th style="padding:4px 8px; width:20%; text-align:right;">GAINS (DA)</th>
                            <th style="padding:4px 8px; width:20%; text-align:right;">RETENUES (DA)</th>
                        </tr>

                        <!-- Salaire de Base -->
                        <tr style="background:#ecf0f1;">
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;">Salaire de Base</td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                <t t-out="'%,.2f' % o.salaire_base"/>
                            </td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                        </tr>

                        <!-- IEP -->
                        <tr>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;">
                                Indemnité d'Expérience Professionnelle (IEP - <t t-out="'%.1f' % o.taux_iep"/>%)
                            </td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                <t t-out="'%,.2f' % o.iep"/>
                            </td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                        </tr>

                        <!-- Indemnité de Panier -->
                        <t t-if="o.indemnite_panier">
                            <tr style="background:#ecf0f1;">
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">Indemnité de Panier</td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.indemnite_panier"/>
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            </tr>
                        </t>

                        <!-- Indemnité de Transport -->
                        <t t-if="o.indemnite_transport">
                            <tr>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">Indemnité de Transport</td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.indemnite_transport"/>
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            </tr>
                        </t>

                        <!-- Indemnités Variables -->
                        <t t-if="o.indemnites_variables">
                            <tr style="background:#ecf0f1;">
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">Indemnités Variables</td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.indemnites_variables"/>
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            </tr>
                        </t>

                        <!-- Prime Responsabilité -->
                        <t t-if="o.prime_responsabilite">
                            <tr>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">Prime de Responsabilité</td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.prime_responsabilite"/>
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            </tr>
                        </t>

                        <!-- Prime Sujétion -->
                        <t t-if="o.prime_sujetion">
                            <tr style="background:#ecf0f1;">
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">Prime de Sujétion</td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.prime_sujetion"/>
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            </tr>
                        </t>

                        <!-- Prime IFSP -->
                        <t t-if="o.prime_ifsp">
                            <tr>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">Prime IFSP</td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.prime_ifsp"/>
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            </tr>
                        </t>

                        <!-- ── Séparateur Retenues ────────────────────── -->
                        <tr style="background:#ecf0f1;">
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;">
                                Cotisation CNAS Salarié (<t t-out="'%.1f' % (o.parametrage_id.taux_cnas_salarie if o.parametrage_id else 9.0)"/>%)
                            </td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                <t t-out="'%,.2f' % o.cnas_salarie"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;">
                                IRG (Base: <t t-out="'%,.2f' % o.base_irg"/> DA)
                            </td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                <t t-out="'%,.2f' % o.irg"/>
                            </td>
                        </tr>

                        <t t-if="o.retenue_retards">
                            <tr style="background:#ecf0f1;">
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">
                                    Retenue Retards (<t t-out="'%.2f' % o.retards_heures"/> h)
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.retenue_retards"/>
                                </td>
                            </tr>
                        </t>

                        <t t-if="o.retenue_absences">
                            <tr>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">
                                    Retenue Absences (<t t-out="'%.1f' % o.jours_absences"/> j)
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.retenue_absences"/>
                                </td>
                            </tr>
                        </t>

                        <!-- Allocations Familiales -->
                        <t t-if="o.allocation_familiale">
                            <tr style="background:#eafaf1;">
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;">
                                    Allocations Familiales (<t t-out="o.nbre_enfants"/> enfant(s))
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                    <t t-out="'%,.2f' % o.allocation_familiale"/>
                                </td>
                                <td style="padding:3px 8px; border:1px solid #bdc3c7;"></td>
                            </tr>
                        </t>

                        <!-- ── Totaux ─────────────────────────────────── -->
                        <tr style="background:#2c3e50; color:white; font-weight:bold;">
                            <td style="padding:5px 8px; border:1px solid #1a252f;">SALAIRE BRUT</td>
                            <td style="padding:5px 8px; border:1px solid #1a252f; text-align:right;">
                                <t t-out="'%,.2f' % o.salaire_brut"/>
                            </td>
                            <td style="padding:5px 8px; border:1px solid #1a252f; text-align:right;">
                                <t t-out="'%,.2f' % o.total_retenues"/>
                            </td>
                        </tr>
                    </table>

                    <!-- ══ NET À PAYER ═══════════════════════════════════ -->
                    <table width="100%" style="border-collapse:collapse; margin-bottom:6px;">
                        <tr style="background:#27ae60; color:white;">
                            <td style="padding:8px 12px; font-size:14px; font-weight:bold; width:60%;">
                                NET À PAYER
                            </td>
                            <td style="padding:8px 12px; font-size:16px; font-weight:bold; text-align:right;">
                                <t t-out="'%,.2f' % o.salaire_net"/> DA
                            </td>
                        </tr>
                    </table>

                    <!-- ══ CHARGES PATRONALES ════════════════════════════ -->
                    <table width="100%" style="border-collapse:collapse; margin-bottom:6px;">
                        <tr style="background:#e74c3c; color:white;">
                            <th colspan="2" style="padding:4px 8px;">INFORMATIONS PATRONALES</th>
                        </tr>
                        <tr>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7; width:60%;">
                                Cotisation CNAS Patronale
                                (<t t-out="'%.1f' % (o.parametrage_id.taux_cnas_patronal if o.parametrage_id else 26.0)"/>%)
                            </td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                <t t-out="'%,.2f' % o.cnas_patronal"/> DA
                            </td>
                        </tr>
                        <tr style="background:#fdf2f2;">
                            <td style="padding:3px 8px; border:1px solid #bdc3c7;"><strong>Charge Patronale Totale</strong></td>
                            <td style="padding:3px 8px; border:1px solid #bdc3c7; text-align:right;">
                                <strong><t t-out="'%,.2f' % o.charge_patronale"/> DA</strong>
                            </td>
                        </tr>
                    </table>

                    <!-- ══ SIGNATURE ═════════════════════════════════════ -->
                    <table width="100%" style="margin-top:20px;">
                        <tr>
                            <td width="33%" style="text-align:center;">
                                <strong>L'Employé</strong><br/><br/><br/>
                                <div style="border-top:1px solid black; margin:0 20px; padding-top:4px;">
                                    Signature
                                </div>
                            </td>
                            <td width="33%" style="text-align:center;">
                                <strong>Service Paie</strong><br/><br/><br/>
                                <div style="border-top:1px solid black; margin:0 20px; padding-top:4px;">
                                    Signature
                                </div>
                            </td>
                            <td width="33%" style="text-align:center;">
                                <strong>Direction des Ressources Humaines</strong><br/><br/><br/>
                                <div style="border-top:1px solid black; margin:0 20px; padding-top:4px;">
                                    Cachet &amp; Signature
                                </div>
                            </td>
                        </tr>
                    </table>

                    <t t-if="o.notes">
                        <div style="margin-top:10px; padding:6px; background:#fffde7; border:1px solid #f9ca24;">
                            <strong>Observations : </strong><t t-out="o.notes"/>
                        </div>
                    </t>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
