<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Séquences ─────────────────────────────────────────────── -->
        <record id="seq_bulletin_paie" model="ir.sequence">
            <field name="name">Bulletin de Paie</field>
            <field name="code">cdc.bulletin.paie</field>
            <field name="prefix">BUL/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_declaration_cnas" model="ir.sequence">
            <field name="name">Déclaration CNAS</field>
            <field name="code">cdc.declaration.cnas</field>
            <field name="prefix">CNAS/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_declaration_irg" model="ir.sequence">
            <field name="name">Déclaration IRG</field>
            <field name="code">cdc.declaration.irg</field>
            <field name="prefix">IRG/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_etat_paie" model="ir.sequence">
            <field name="name">État de Paie</field>
            <field name="code">cdc.etat.paie</field>
            <field name="prefix">ETAT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ── Rubriques par défaut ──────────────────────────────────── -->
        <record id="rubrique_salaire_base" model="cdc.rubrique.paie">
            <field name="code">001</field>
            <field name="name">Salaire de Base</field>
            <field name="sequence">1</field>
            <field name="type_rubrique">gain</field>
            <field name="mode_calcul">fixe</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">True</field>
            <field name="cotisable_cnas">True</field>
        </record>

        <record id="rubrique_iep" model="cdc.rubrique.paie">
            <field name="code">002</field>
            <field name="name">Indemnité d'Expérience Professionnelle (IEP)</field>
            <field name="sequence">2</field>
            <field name="type_rubrique">indemnite</field>
            <field name="mode_calcul">taux_salaire</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">True</field>
            <field name="cotisable_cnas">True</field>
        </record>

        <record id="rubrique_panier" model="cdc.rubrique.paie">
            <field name="code">010</field>
            <field name="name">Indemnité de Panier</field>
            <field name="sequence">10</field>
            <field name="type_rubrique">indemnite</field>
            <field name="mode_calcul">fixe</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">False</field>
            <field name="cotisable_cnas">False</field>
        </record>

        <record id="rubrique_transport" model="cdc.rubrique.paie">
            <field name="code">011</field>
            <field name="name">Indemnité de Transport</field>
            <field name="sequence">11</field>
            <field name="type_rubrique">indemnite</field>
            <field name="mode_calcul">fixe</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">False</field>
            <field name="cotisable_cnas">False</field>
        </record>

        <record id="rubrique_prime_responsabilite" model="cdc.rubrique.paie">
            <field name="code">020</field>
            <field name="name">Prime de Responsabilité</field>
            <field name="sequence">20</field>
            <field name="type_rubrique">prime</field>
            <field name="mode_calcul">fixe</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">True</field>
            <field name="cotisable_cnas">True</field>
        </record>

        <record id="rubrique_prime_sujetion" model="cdc.rubrique.paie">
            <field name="code">021</field>
            <field name="name">Prime de Sujétion</field>
            <field name="sequence">21</field>
            <field name="type_rubrique">prime</field>
            <field name="mode_calcul">fixe</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">True</field>
            <field name="cotisable_cnas">True</field>
        </record>

        <record id="rubrique_ifsp" model="cdc.rubrique.paie">
            <field name="code">022</field>
            <field name="name">Prime IFSP</field>
            <field name="sequence">22</field>
            <field name="type_rubrique">prime</field>
            <field name="mode_calcul">fixe</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">True</field>
            <field name="cotisable_cnas">True</field>
        </record>

        <record id="rubrique_cnas_sal" model="cdc.rubrique.paie">
            <field name="code">100</field>
            <field name="name">Cotisation CNAS (Part Salarié)</field>
            <field name="sequence">100</field>
            <field name="type_rubrique">cotisation_sal</field>
            <field name="mode_calcul">cnas</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">False</field>
            <field name="cotisable_cnas">False</field>
        </record>

        <record id="rubrique_irg" model="cdc.rubrique.paie">
            <field name="code">110</field>
            <field name="name">IRG (Impôt sur le Revenu Global)</field>
            <field name="sequence">110</field>
            <field name="type_rubrique">impot</field>
            <field name="mode_calcul">irg</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">False</field>
            <field name="cotisable_cnas">False</field>
        </record>

        <record id="rubrique_alloc_familiale" model="cdc.rubrique.paie">
            <field name="code">200</field>
            <field name="name">Allocations Familiales</field>
            <field name="sequence">200</field>
            <field name="type_rubrique">allocation</field>
            <field name="mode_calcul">formule</field>
            <field name="formule">nbre_enfants * 600</field>
            <field name="apparait_bulletin">True</field>
            <field name="imposable">False</field>
            <field name="cotisable_cnas">False</field>
        </record>

    </data>
</odoo>
