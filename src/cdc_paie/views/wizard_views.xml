<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Wizard Générer Bulletins ──────────────────────────────────────── -->
    <record id="view_wizard_generer_bulletins_form" model="ir.ui.view">
        <field name="name">cdc.wizard.generer.bulletins.form</field>
        <field name="model">cdc.wizard.generer.bulletins</field>
        <field name="arch" type="xml">
            <form string="Générer Bulletins en Masse">
                <group string="Période">
                    <field name="mois"/>
                    <field name="annee"/>
                    <field name="parametrage_id"/>
                    <field name="type_bulletin"/>
                </group>
                <group string="Filtres">
                    <field name="direction_ids" widget="many2many_tags"/>
                    <field name="ecrase_existants"/>
                </group>
                <group string="Résumé">
                    <field name="nb_employes" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generer" string="Générer les Bulletins"
                            type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_generer_bulletins" model="ir.actions.act_window">
        <field name="name">Générer Bulletins en Masse</field>
        <field name="res_model">cdc.wizard.generer.bulletins</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ── Wizard Virement ───────────────────────────────────────────────── -->
    <record id="view_wizard_virement_form" model="ir.ui.view">
        <field name="name">cdc.wizard.virement.form</field>
        <field name="model">cdc.wizard.virement</field>
        <field name="arch" type="xml">
            <form string="Générer Fichier de Virement">
                <group string="Paramètres">
                    <field name="mois"/>
                    <field name="annee"/>
                    <field name="type_virement"/>
                </group>
                <group string="Résultat" invisible="state == 'draft'">
                    <field name="nb_beneficiaires" readonly="1"/>
                    <field name="total_net" readonly="1"/>
                    <field name="fichier" widget="binary" filename="fichier_name" readonly="1"/>
                    <field name="fichier_name" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generer" string="Générer le Fichier"
                            type="object" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_virement" model="ir.actions.act_window">
        <field name="name">Générer Fichier de Virement</field>
        <field name="res_model">cdc.wizard.virement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add wizard actions to menu -->
    <menuitem id="menu_paie_wizard_bulletins"
              name="Générer Bulletins en Masse"
              parent="menu_paie_bulletins"
              action="action_wizard_generer_bulletins"
              sequence="10"
              groups="cdc_paie.group_paie_admin"/>

    <menuitem id="menu_paie_wizard_virement"
              name="Fichier de Virement"
              parent="menu_paie_reporting"
              action="action_wizard_virement"
              sequence="5"
              groups="cdc_paie.group_paie_chef"/>

</odoo>
