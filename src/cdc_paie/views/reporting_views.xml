<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etat_paie_form" model="ir.ui.view">
        <field name="name">cdc.etat.paie.form</field>
        <field name="model">cdc.etat.paie</field>
        <field name="arch" type="xml">
            <form string="État de Paie">
                <header>
                    <button name="action_generer" string="Générer" type="object"
                            class="btn-primary" invisible="state != 'brouillon'"/>
                    <button name="action_telecharger_ccp" string="Télécharger Fichier CCP"
                            type="object" class="btn-secondary"
                            invisible="type_etat not in ('fichier_ccp','virement_ccp') or state == 'brouillon'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Paramètres">
                            <field name="type_etat"/>
                            <field name="annee"/>
                            <field name="mois" placeholder="Tous l'annee "/>
<field name="direction_id" 
       placeholder="Tous les services (laisser vide)"
       options="{'no_create': True, 'no_open': True}"
       can_create="False"/>                           <field name="categorie"/>
                        </group>
                        <group string="Totaux" readonly="1">
                            <field name="effectif"/>
                            <field name="total_brut"/>
                            <field name="total_cnas_sal"/>
                            <field name="total_irg"/>
                            <field name="total_net"/>
                            <field name="total_charge_patronale"/>
                            <field name="total_masse_salariale"/>
                        </group>
                    </group>
                    <group invisible="type_etat not in ('fichier_ccp','virement_ccp')"
                           string="Fichier CCP">
                        <field name="fichier_ccp" widget="binary"
                               filename="fichier_ccp_name"/>
                        <field name="fichier_ccp_name"/>
                    </group>
                    <field name="ligne_ids" readonly="1">
                        <list>
                            <field name="employe_id"/>
                            <field name="matricule"/>
                            <field name="grade"/>
                            <field name="fonction"/>
                            <field name="categorie"/>
                            <field name="mois"/>
                            <field name="salaire_base"/>
                            <field name="salaire_brut"/>
                            <field name="cnas_salarie"/>
                            <field name="cnas_patronal"/>
                            <field name="irg"/>
                            <field name="allocation_familiale"/>
                            <field name="salaire_net"/>
                            <field name="charge_patronale"/>
                            <field name="moyen_paiement"/>
                            <field name="num_compte"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_etat_paie_list" model="ir.ui.view">
        <field name="name">cdc.etat.paie.list</field>
        <field name="model">cdc.etat.paie</field>
        <field name="arch" type="xml">
            <list string="États de Paie">
                <field name="name"/>
                <field name="type_etat"/>
                <field name="mois"/>
                <field name="annee"/>
                <field name="direction_id"/>
                <field name="categorie"/>
                <field name="effectif"/>
                <field name="total_brut"/>
                <field name="total_net"/>
                <field name="total_masse_salariale"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_etat_paie_search" model="ir.ui.view">
        <field name="name">cdc.etat.paie.search</field>
        <field name="model">cdc.etat.paie</field>
        <field name="arch" type="xml">
            <search string="Recherche États">

                <!-- بحث نصي -->
                <field name="name" string="Référence"/>
                <field name="type_etat" string="Type d'État"/>
                <field name="direction_id" string="Direction / Service"/>
                <field name="annee" string="Année"/>

                <!-- فلاتر الأشهر -->
                <filter string="Janvier"   name="mois_1"  domain="[('mois','=','1')]"/>
                <filter string="Février"   name="mois_2"  domain="[('mois','=','2')]"/>
                <filter string="Mars"      name="mois_3"  domain="[('mois','=','3')]"/>
                <filter string="Avril"     name="mois_4"  domain="[('mois','=','4')]"/>
                <filter string="Mai"       name="mois_5"  domain="[('mois','=','5')]"/>
                <filter string="Juin"      name="mois_6"  domain="[('mois','=','6')]"/>
                <filter string="Juillet"   name="mois_7"  domain="[('mois','=','7')]"/>
                <filter string="Août"      name="mois_8"  domain="[('mois','=','8')]"/>
                <filter string="Septembre" name="mois_9"  domain="[('mois','=','9')]"/>
                <filter string="Octobre"   name="mois_10" domain="[('mois','=','10')]"/>
                <filter string="Novembre"  name="mois_11" domain="[('mois','=','11')]"/>
                <filter string="Décembre"  name="mois_12" domain="[('mois','=','12')]"/>

                <separator/>

                <!-- فلاتر الفئة -->
                <filter string="Cadre"     name="cat_cadre"     domain="[('categorie','=','cadre')]"/>
                <filter string="Maîtrise"  name="cat_maitrise"  domain="[('categorie','=','maitrise')]"/>
                <filter string="Exécution" name="cat_execution" domain="[('categorie','=','execution')]"/>

                <separator/>

                <!-- فلاتر الحالة -->
                <filter string="Brouillon" name="state_brouillon" domain="[('state','=','brouillon')]"/>
                <filter string="Généré"    name="state_genere"    domain="[('state','=','genere')]"/>

                <!-- تجميع -->
                <group expand="1" string="Regrouper par">
                    <filter string="Direction / Service" name="group_direction"
                            context="{'group_by': 'direction_id'}"/>
                    <filter string="Mois"   name="group_mois"   context="{'group_by': 'mois'}"/>
                    <filter string="Année"  name="group_annee"  context="{'group_by': 'annee'}"/>
                    <filter string="Type"   name="group_type"   context="{'group_by': 'type_etat'}"/>
                    <filter string="Catégorie" name="group_cat" context="{'group_by': 'categorie'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_etat_paie" model="ir.actions.act_window">
        <field name="name">États de Paie</field>
        <field name="res_model">cdc.etat.paie</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_etat_paie_search"/>
    </record>

</odoo>