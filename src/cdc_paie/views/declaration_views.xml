<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Déclaration CNAS Form ─────────────────────────────────────────── -->
    <record id="view_declaration_cnas_form" model="ir.ui.view">
        <field name="name">cdc.declaration.cnas.form</field>
        <field name="model">cdc.declaration.cnas</field>
        <field name="arch" type="xml">
            <form string="Déclaration CNAS">
                <header>
                    <button name="action_generer" string="Générer les Lignes"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_imprimer" string="Imprimer"
                            type="object" class="btn-secondary"
                            invisible="state == 'brouillon'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="type_declaration"/>
                            <field name="mois"/>
                            <field name="annee"/>
                            <field name="num_affiliation"/>
                        </group>
                        <group string="Totaux">
                            <field name="effectif" readonly="1"/>
                            <field name="montant_cotisable" readonly="1"/>
                            <field name="total_cnas_salarie" readonly="1"/>
                            <field name="total_cnas_patronal" readonly="1"/>
                            <field name="total_cnas" readonly="1"/>
                        </group>
                    </group>
                    <field name="ligne_ids">
                        <list>
                            <field name="employe_id"/>
                            <field name="matricule"/>
                            <field name="num_affiliation"/>
                            <field name="salaire_base"/>
                            <field name="montant_cotisable"/>
                            <field name="cnas_salarie"/>
                            <field name="cnas_patronal"/>
                            <field name="total_cnas"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_declaration_cnas_list" model="ir.ui.view">
        <field name="name">cdc.declaration.cnas.list</field>
        <field name="model">cdc.declaration.cnas</field>
        <field name="arch" type="xml">
            <list string="Déclarations CNAS">
                <field name="name"/>
                <field name="type_declaration"/>
                <field name="mois"/>
                <field name="annee"/>
                <field name="effectif"/>
                <field name="montant_cotisable"/>
                <field name="total_cnas"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_declaration_cnas" model="ir.actions.act_window">
        <field name="name">Déclarations CNAS</field>
        <field name="res_model">cdc.declaration.cnas</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Déclaration IRG Form ──────────────────────────────────────────── -->
    <record id="view_declaration_irg_form" model="ir.ui.view">
        <field name="name">cdc.declaration.irg.form</field>
        <field name="model">cdc.declaration.irg</field>
        <field name="arch" type="xml">
            <form string="Déclaration IRG">
                <header>
                    <button name="action_generer" string="Générer les Lignes"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_imprimer" string="Imprimer"
                            type="object" class="btn-secondary"
                            invisible="state == 'brouillon'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="type_declaration"/>
                            <field name="mois"/>
                            <field name="annee"/>
                        </group>
                        <group string="Totaux">
                            <field name="effectif" readonly="1"/>
                            <field name="total_base_irg" readonly="1"/>
                            <field name="total_irg" readonly="1"/>
                        </group>
                    </group>
                    <field name="ligne_ids">
                        <list>
                            <field name="employe_id"/>
                            <field name="matricule"/>
                            <field name="mois"/>
                            <field name="salaire_brut"/>
                            <field name="base_irg"/>
                            <field name="irg"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_declaration_irg_list" model="ir.ui.view">
        <field name="name">cdc.declaration.irg.list</field>
        <field name="model">cdc.declaration.irg</field>
        <field name="arch" type="xml">
            <list string="Déclarations IRG">
                <field name="name"/>
                <field name="type_declaration"/>
                <field name="mois"/>
                <field name="annee"/>
                <field name="effectif"/>
                <field name="total_base_irg"/>
                <field name="total_irg"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_declaration_irg" model="ir.actions.act_window">
        <field name="name">Déclarations IRG</field>
        <field name="res_model">cdc.declaration.irg</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
