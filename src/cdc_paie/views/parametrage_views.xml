<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Paramétrage de la Paie ─────────────────────────────────────────── -->
    <record id="view_parametrage_paie_form" model="ir.ui.view">
        <field name="name">cdc.parametrage.paie.form</field>
        <field name="model">cdc.parametrage.paie</field>
        <field name="arch" type="xml">
            <form string="Paramétrage de la Paie">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Clôturer" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_draft" string="Remettre en Brouillon" type="object"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="mois" readonly="state != 'draft'"/>
                            <field name="annee" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="jours_ouvrables"/>
                        </group>
                        <group string="SMIG">
                            <field name="smig"/>
                        </group>
                    </group>
                    <group>
                        <group string="CNAS">
                            <field name="taux_cnas_salarie"/>
                            <field name="taux_cnas_patronal"/>
                            <field name="plafond_cnas"/>
                        </group>
                        <group string="Indemnités Légales">
                            <field name="indemnite_panier"/>
                            <field name="indemnite_transport"/>
                            <field name="taux_allocation_familiale"/>
                            <field name="taux_iep"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Barème IRG">
                            <field name="taux_irg_ids">
                                <list editable="bottom">
                                    <field name="tranche_min"/>
                                    <field name="tranche_max"/>
                                    <field name="taux"/>
                                    <field name="deduction"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_parametrage_paie_list" model="ir.ui.view">
        <field name="name">cdc.parametrage.paie.list</field>
        <field name="model">cdc.parametrage.paie</field>
        <field name="arch" type="xml">
            <list string="Paramétrages de Paie" decoration-success="state=='confirmed'"
                  decoration-muted="state=='closed'">
                <field name="mois"/>
                <field name="annee"/>
                <field name="smig"/>
                <field name="taux_cnas_salarie"/>
                <field name="taux_cnas_patronal"/>
                <field name="jours_ouvrables"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_parametrage_paie" model="ir.actions.act_window">
        <field name="name">Paramétrage Paie</field>
        <field name="res_model">cdc.parametrage.paie</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Calendrier de Paie ─────────────────────────────────────────────── -->
    <record id="view_calendrier_paie_form" model="ir.ui.view">
        <field name="name">cdc.calendrier.paie.form</field>
        <field name="model">cdc.calendrier.paie</field>
        <field name="arch" type="xml">
            <form string="Calendrier de Paie">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="annee"/>
                            <field name="mois"/>
                        </group>
                        <group>
                            <field name="date_traitement"/>
                            <field name="date_paiement"/>
                            <field name="state" widget="badge"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_calendrier_paie_list" model="ir.ui.view">
        <field name="name">cdc.calendrier.paie.list</field>
        <field name="model">cdc.calendrier.paie</field>
        <field name="arch" type="xml">
            <list string="Calendrier de Paie">
                <field name="name"/>
                <field name="mois"/>
                <field name="annee"/>
                <field name="date_traitement"/>
                <field name="date_paiement"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_calendrier_paie" model="ir.actions.act_window">
        <field name="name">Calendrier de Paie</field>
        <field name="res_model">cdc.calendrier.paie</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
