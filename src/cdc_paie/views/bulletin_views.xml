<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Bulletin de Paie Form ──────────────────────────────────────────── -->
    <record id="view_bulletin_paie_form" model="ir.ui.view">
        <field name="name">cdc.bulletin.paie.form</field>
        <field name="model">cdc.bulletin.paie</field>
        <field name="arch" type="xml">
            <form string="Bulletin de Paie">
                <header>
                    <button name="action_calculer" string="Calculer" type="object"
                            class="btn-primary"
                            invisible="state not in ('brouillon','calcule')"/>
                    <button name="action_valider" string="Valider" type="object"
                            class="btn-primary"
                            invisible="state != 'calcule'"/>
                    <button name="action_payer" string="Marquer Payé" type="object"
                            class="btn-success"
                            invisible="state != 'valide'"/>
                    <button name="action_imprimer_bulletin" string="Imprimer" type="object"
                            class="btn-secondary"
                            invisible="state == 'brouillon'"/>
                    <button name="action_annuler" string="Annuler" type="object"
                            invisible="state in ('paye','annule')"/>
                    <button name="action_remettre_brouillon" string="Remettre Brouillon"
                            type="object" invisible="state != 'annule'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,calcule,valide,paye"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- ── Identification ─────────────────────────────── -->
                    <group string="Identification">
                        <group>
                            <field name="employe_id" readonly="state != 'brouillon'"/>
                            <field name="matricule" readonly="1"/>
                            <field name="grade" readonly="1"/>
                            <field name="fonction" readonly="1"/>
                            <field name="categorie" readonly="1"/>
                            <field name="direction_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="mois" readonly="state != 'brouillon'"/>
                            <field name="annee" readonly="state != 'brouillon'"/>
                            <field name="type_bulletin" readonly="state != 'brouillon'"/>
                            <field name="parametrage_id" readonly="state != 'brouillon'"/>
                            <field name="situation_familiale" readonly="1"/>
                            <field name="nbre_enfants" readonly="1"/>
                            <field name="num_securite_sociale" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ── Présence ──────────────────────────────── -->
                        <page string="Présence / Absences" name="presence">
                            <group>
                                <group string="Jours">
                                    <field name="jours_ouvrables"/>
                                    <field name="jours_travailles"/>
                                    <field name="jours_conges"/>
                                    <field name="jours_absences"/>
                                    <field name="retards_heures"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Éléments Salaire ───────────────────────── -->
                        <page string="Éléments de Salaire" name="salaire">
                            <group string="Salaire de Base">
                                <field name="salaire_base" readonly="1"/>
                                <field name="salaire_poste" readonly="1"/>
                                <field name="taux_iep" readonly="1"/>
                                <field name="iep" readonly="1"/>
                            </group>
                            <group string="Indemnités">
                                <field name="indemnite_panier"/>
                                <field name="indemnite_transport"/>
                                <field name="indemnites_variables"/>
                            </group>
                            <group string="Primes">
                                <field name="prime_responsabilite" readonly="1"/>
                                <field name="prime_sujetion" readonly="1"/>
                                <field name="prime_ifsp" readonly="1"/>
                            </group>
                        </page>

                        <!-- ── Résultats Calcul ──────────────────────── -->
                        <page string="Résultats" name="resultats">
                            <group string="Brut">
                                <field name="salaire_brut" readonly="1"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="montant_cotisable" readonly="1"/>
                            </group>
                            <group string="Cotisations et Impôts">
                                <field name="cnas_salarie" readonly="1"/>
                                <field name="cnas_patronal" readonly="1"/>
                                <field name="base_irg" readonly="1"/>
                                <field name="irg" readonly="1"/>
                                <field name="allocation_familiale" readonly="1"/>
                            </group>
                            <group string="Retenues">
                                <field name="retenue_retards" readonly="1"/>
                                <field name="retenue_absences" readonly="1"/>
                                <field name="total_retenues" readonly="1"/>
                            </group>
                            <group string="Net / Charge">
                                <field name="salaire_net" readonly="1"
                                       class="o_field_highlight"/>
                                <field name="charge_patronale" readonly="1"/>
                            </group>
                        </page>

                        <!-- ── Rubriques détaillées ──────────────────── -->
                        <page string="Rubriques Détaillées" name="rubriques">
                            <field name="ligne_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rubrique_id"/>
                                    <field name="code" readonly="1"/>
                                    <field name="type_rubrique" widget="badge"/>
                                    <field name="montant"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Paiement ───────────────────────────────── -->
                        <page string="Paiement" name="paiement">
                            <group>
                                <field name="moyen_paiement" readonly="1"/>
                                <field name="num_compte" readonly="1"/>
                            </group>
                        </page>

                    </notebook>
                    <field name="notes" placeholder="Notes / Observations..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Bulletin de Paie List ─────────────────────────────────────────── -->
    <record id="view_bulletin_paie_list" model="ir.ui.view">
        <field name="name">cdc.bulletin.paie.list</field>
        <field name="model">cdc.bulletin.paie</field>
        <field name="arch" type="xml">
            <list string="Bulletins de Paie"
                  decoration-success="state=='paye'"
                  decoration-info="state=='valide'"
                  decoration-warning="state=='calcule'"
                  decoration-muted="state=='annule'">
                <field name="name"/>
                <field name="employe_id"/>
                <field name="matricule"/>
                <field name="direction_id"/>
                <field name="mois"/>
                <field name="annee"/>
                <field name="type_bulletin"/>
                <field name="salaire_base"/>
                <field name="salaire_brut"/>
                <field name="cnas_salarie"/>
                <field name="irg"/>
                <field name="salaire_net"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ── Bulletin de Paie Search ───────────────────────────────────────── -->
    <record id="view_bulletin_paie_search" model="ir.ui.view">
        <field name="name">cdc.bulletin.paie.search</field>
        <field name="model">cdc.bulletin.paie</field>
        <field name="arch" type="xml">
            <search string="Recherche Bulletins">
                <field name="employe_id"/>
                <field name="matricule"/>
                <field name="direction_id"/>
                <field name="mois"/>
                <field name="annee"/>
                <filter string="Brouillon" name="brouillon" domain="[('state','=','brouillon')]"/>
                <filter string="Calculés" name="calcule" domain="[('state','=','calcule')]"/>
                <filter string="Validés" name="valide" domain="[('state','=','valide')]"/>
                <filter string="Payés" name="paye" domain="[('state','=','paye')]"/>
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter string="Employé" name="group_employe"
                            context="{'group_by': 'employe_id'}"/>
                    <filter string="Direction" name="group_direction"
                            context="{'group_by': 'direction_id'}"/>
                    <filter string="Mois" name="group_mois"
                            context="{'group_by': 'mois'}"/>
                    <filter string="Année" name="group_annee"
                            context="{'group_by': 'annee'}"/>
                    <filter string="État" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="action_bulletin_paie" model="ir.actions.act_window">
        <field name="name">Bulletins de Paie</field>
        <field name="res_model">cdc.bulletin.paie</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bulletin_paie_search"/>
    </record>

</odoo>
