<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- HR Medical Views -->
        <record model="ir.ui.view" id="view_hr_dz_medical_form">
            <field name="name">hr.medical.form</field>
            <field name="model">hr.medical</field>
            <field name="arch" type="xml">
                <form string="Dossiers médicaux">
                     <sheet>

                        <group>
                            <field name="employee_id"/>
                            <field name="incident_type"/>
                        </group>

                        <group string="Consultation">
                            <field name="visit_date"/>
                            <field name="doctor"/>
                            <field name="clinic"/>
                            <field name="next_visit"/>
                        </group>

                        <group string="Détails médicaux">
                            <field name="diagnosis"/>
                            <field name="treatment"/>
                            <field name="notes"/>
                        </group>

                        <group string="Pièces jointes">
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   string="Documents médicaux"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_dz_medical_list">
            <field name="name">hr.medical.list</field>
            <field name="model">hr.medical</field>
            <field name="arch" type="xml">
                <list string="Dossiers médicaux">
                    <field name="employee_id"/>
                    <field name="incident_type"/>
                    <field name="visit_date"/>
                    <field name="doctor"/>
                    <field name="clinic"/>
                    <field name="next_visit"/>
                </list>
            </field>
        </record>

        <!-- HR Medical Action -->
        <record model="ir.actions.act_window" id="action_hr_dz_medical">
            <field name="name">Dossiers médicaux</field>
            <field name="res_model">hr.medical</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
