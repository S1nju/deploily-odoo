<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Mock Category -->
        <record id="mock_category_language" model="school.service.category">
            <field name="name">اللغات الأجنبية (Foreign Languages)</field>
        </record>
        <record id="mock_subcategory_english" model="school.service.subcategory">
            <field name="name">اللغة الإنجليزية (English)</field>
            <field name="category_id" ref="school_management_dz.mock_category_language"/>
        </record>
        
        <!-- Mock Tutor (HR Employee) -->
        <record id="mock_tutor_john" model="hr.employee">
            <field name="name">John Doe (Mock Tutor)</field>
            <field name="job_title">English Teacher</field>
        </record>

        <!-- Mock Course -->
        <record id="mock_course_english_101" model="school.course">
            <field name="name">English 101 Beginners</field>
            <field name="subcategory_id" ref="school_management_dz.mock_subcategory_english"/>
            <field name="tutor_id" ref="school_management_dz.mock_tutor_john"/>
            <field name="is_published" eval="True"/>
            <field name="description"><![CDATA[<p>Welcome to English 101. This course covers basic vocabulary and grammar.</p>]]></field>
        </record>

        <!-- Mock Test -->
        <record id="mock_test_placement" model="school.course.test">
            <field name="name">Initial Placement Test</field>
            <field name="course_id" ref="school_management_dz.mock_course_english_101"/>
            <field name="description">1. Introduce yourself in 2 lines.
2. What are your expectations from this course?</field>
        </record>
    </data>
</odoo>
