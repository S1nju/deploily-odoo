<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Optional: add custom groups here. For now we use standard groups -->
        <record id="group_school_manager" model="res.groups">
            <field name="name">School Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
        
        <record id="group_school_tutor" model="res.groups">
            <field name="name">School Tutor</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record rules for Tutors -->
        <record id="rule_tutor_course" model="ir.rule">
            <field name="name">Tutor Course Access</field>
            <field name="model_id" ref="model_school_course"/>
            <field name="domain_force">[('tutor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('school_management_dz.group_school_tutor'))]"/>
        </record>

        <record id="rule_tutor_attendance" model="ir.rule">
            <field name="name">Tutor Attendance Access</field>
            <field name="model_id" ref="model_school_attendance"/>
            <field name="domain_force">[('course_id.tutor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('school_management_dz.group_school_tutor'))]"/>
        </record>

        <record id="rule_tutor_student" model="ir.rule">
            <field name="name">Tutor Student Details</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[('registration_ids.course_id.tutor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('school_management_dz.group_school_tutor'))]"/>
        </record>

        <record id="rule_tutor_registration" model="ir.rule">
            <field name="name">Tutor Registration Access</field>
            <field name="model_id" ref="model_school_registration"/>
            <field name="domain_force">[('course_id.tutor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('school_management_dz.group_school_tutor'))]"/>
        </record>

        <record id="rule_tutor_challenge" model="ir.rule">
            <field name="name">Tutor Challenge Access</field>
            <field name="model_id" ref="model_school_student_challenge"/>
            <field name="domain_force">[('registration_id.course_id.tutor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('school_management_dz.group_school_tutor'))]"/>
        </record>

        <record id="rule_tutor_session" model="ir.rule">
            <field name="name">Tutor Session Access</field>
            <field name="model_id" ref="model_school_course_session"/>
            <field name="domain_force">[('course_id.tutor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('school_management_dz.group_school_tutor'))]"/>
        </record>

        <!-- Record rules for Portal Parents (Restrict to own students/registrations) -->
        <record id="rule_portal_student" model="ir.rule">
            <field name="name">Portal Student Access</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[('parent_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_portal_registration" model="ir.rule">
            <field name="name">Portal Registration Access</field>
            <field name="model_id" ref="model_school_registration"/>
            <field name="domain_force">[('parent_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_portal_attendance" model="ir.rule">
            <field name="name">Portal Attendance Access</field>
            <field name="model_id" ref="model_school_attendance"/>
            <field name="domain_force">[('student_id.parent_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_portal_challenge" model="ir.rule">
            <field name="name">Portal Challenge Access</field>
            <field name="model_id" ref="model_school_student_challenge"/>
            <field name="domain_force">[('registration_id.parent_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        
        <record id="seq_school_registration" model="ir.sequence">
            <field name="name">School Registration Sequence</field>
            <field name="code">school.registration.seq</field>
            <field name="prefix">REG-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
