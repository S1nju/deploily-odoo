<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="parent_setup_form" name="Parent Setup Form">
        <t t-call="website.layout">
            <div class="container mt-4 mb-4">
                <h2>Account Information Setup</h2>
                <form action="/my/parent/setup" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="form-group mb-3">
                        <label for="parent_activity">Current Activity *</label>
                        <select name="parent_activity" class="form-control" required="required">
                            <option value="housewife">ربة بيت</option>
                            <option value="employee">موظف / عامل يومي</option>
                            <option value="business_owner">صاحب مؤسسة / شركة / جمعية</option>
                            <option value="freelancer">حرفي / عامل حر</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label for="mahara_participation">Participated in Mahara before? *</label>
                        <select name="mahara_participation" class="form-control" required="required">
                            <option value="yes">نعم</option>
                            <option value="no">لا</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Information</button>
                </form>
            </div>
        </t>
    </template>

    <template id="services_catalog" name="Services Catalog">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h2>Our Services</h2>
                <div class="row">
                    <t t-foreach="categories" t-as="cat">
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title"><t t-esc="cat.name"/></h5>
                                    <a t-attf-href="/services/#{slug(cat)}" class="btn btn-primary">View Courses</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    
    <template id="services_category" name="Service Category Details">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h2><t t-esc="category.name"/></h2>
                <t t-foreach="category.subcategory_ids" t-as="sub">
                    <h4 class="mt-3"><t t-esc="sub.name"/></h4>
                    <ul class="list-group">
                        <t t-foreach="sub.course_ids" t-as="course">
                            <li class="list-group-item">
                                <a t-attf-href="/course/#{slug(course)}"><t t-esc="course.name"/></a>
                            </li>
                        </t>
                    </ul>
                </t>
            </div>
        </t>
    </template>
    
    <template id="course_details" name="Course Details">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="oe_structure"/>
                <section class="container mt-4 mb-4">
                    <a href="/courses" class="btn btn-secondary mb-3"><i class="fa fa-arrow-left"></i> Back to Courses</a>
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <div t-if="course.image_1920" class="mb-3">
                                <img t-attf-src="data:image/png;base64,#{course.image_1920}" class="img-fluid rounded shadow" alt="Course Image"/>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <h2 t-field="course.name"/>
                            <p><strong>Level/Year:</strong> <span t-field="course.subcategory_id.name"/></p>
                            <p><strong>Tutor:</strong> <span t-esc="course.tutor_id.sudo().name"/></p>
                            <p><strong>Starts:</strong> <span t-field="course.start_date"/></p>
                            <p><strong>Center:</strong> <span t-field="course.center_id.name"/></p>
                            <p t-if="course.location"><strong>Details/Location:</strong> <span t-field="course.location"/></p>
                            
                            <t t-if="course.schedule_ids">
                                <p><strong>Schedule:</strong></p>
                                <ul class="list-group mb-3">
                                    <t t-foreach="course.schedule_ids" t-as="sched">
                                        <li class="list-group-item">
                                            <strong><t t-esc="sched.weekday_string"/>:</strong>
                                            <t t-esc="sched.time_string"/>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                            
                            <div class="mt-3">
                                <t t-raw="course.description"/>
                            </div>
                            
                            <div class="mt-4 alert alert-warning text-end" dir="rtl">
                                <strong>تذكير :</strong><br/>
                                *<br/>
                                يُعتبر هذا التسجيل أوليًّا في البرنامج، وسيتمُّ التواصل معكم قريبا<br/>
                                تأكيد التسجيل وضمان المقعد يكون بتسديد اشتراك البرنامج
                            </div>
                            <div class="mt-3 alert alert-info">
                                You can register below. Please ensure your account profile is completed.
                            </div>
                            <a t-attf-href="/course/#{slug(course)}/register" class="btn btn-success mt-3">Register Now / سجل الآن</a>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    
    <template id="course_register_form" name="Course Registration Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="container mt-4 mb-4">
                    <h2>Registration: <span t-field="course.name"/></h2>
                    <p class="text-muted mb-1"><strong>Level:</strong> <span t-field="course.subcategory_id.name"/></p>
                    <p class="text-muted"><strong>Center:</strong> <span t-field="course.center_id.name"/></p>
                    <form t-attf-action="/course/#{slug(course)}/register" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    
                    <h4>Student Information</h4>
                    
                    <t t-set="existing_students" t-value="request.env['school.student'].sudo().search([('parent_id', '=', request.env.user.partner_id.id)])"/>
                    <t t-if="existing_students">
                        <div class="mb-3">
                            <label><strong>Select Student Profile</strong> *</label>
                            <select name="existing_student_id" id="existing_student_id" class="form-control" onchange="if(this.value == 'new'){document.getElementById('new_student_fields').style.display='block';}else{document.getElementById('new_student_fields').style.display='none';}">
                                <option value="self">-- Register Myself --</option>
                                <option value="new">-- Register a New Child / Student --</option>
                                <t t-foreach="existing_students" t-as="c">
                                    <option t-att-value="c.id"><t t-esc="c.name"/></option>
                                </t>
                            </select>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="mb-3">
                            <label><strong>Select Student Profile</strong> *</label>
                            <select name="existing_student_id" id="existing_student_id" class="form-control" onchange="if(this.value == 'new'){document.getElementById('new_student_fields').style.display='block';}else{document.getElementById('new_student_fields').style.display='none';}">
                                <option value="self">-- Register Myself --</option>
                                <option value="new" selected="1">-- Register a New Child / Student --</option>
                            </select>
                        </div>
                    </t>
                    
                    <div id="new_student_fields" style="display: none;">
                        <div class="mb-3">
                            <label><strong>Student's Full Name</strong> (if new) *</label>
                            <input type="text" name="student_name" class="form-control" placeholder="Enter full name of the student..."/>
                        </div>
                        <div class="mb-3">
                            <label><strong>ماهي علاقتكم بالمشارك ؟</strong> *</label>
                            <select name="student_relationship" class="form-control">
                                <option value="father">أب</option>
                                <option value="mother">أم</option>
                                <option value="guardian">وكيل</option>
                                <option value="family">أحد أفراد العائلة</option>
                                <option value="self">أنا هو المعني - الطالب (ة)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label><strong>Previous Year's Grades (Optional Upload)</strong></label>
                            <input type="file" name="student_grades_file" class="form-control" accept="image/*,application/pdf"/>
                        </div>
                    </div>
                    
                    <t t-if="course.test_ids">
                        <h4 class="mt-4">Assessment Test</h4>
                        <t t-foreach="course.test_ids" t-as="test">
                            <div class="alert alert-secondary">
                                <strong><t t-esc="test.name"/></strong>
                                <p><t t-esc="test.description"/></p>
                                
                                <t t-foreach="test.question_ids" t-as="question">
                                    <div class="mb-3 mt-3">
                                        <label><strong><t t-esc="question.name"/></strong> *</label>
                                        <t t-if="question.question_type == 'text'">
                                            <textarea t-attf-name="question_#{question.id}" class="form-control" rows="2" required="required"></textarea>
                                        </t>
                                        <t t-if="question.question_type == 'boolean'">
                                            <select t-attf-name="question_#{question.id}" class="form-control" required="required">
                                                <option value="yes">نعم (Yes)</option>
                                                <option value="no">لا (No)</option>
                                            </select>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>
                    
                    <button type="submit" class="btn btn-primary mt-3">Submit Registration</button>
                    
                    <script type="text/javascript">
                        document.addEventListener("DOMContentLoaded", function() {
                            var dropdown = document.getElementById('existing_student_id');
                            var new_fields = document.getElementById('new_student_fields');
                            if(dropdown.value == 'new'){
                                new_fields.style.display = 'block';
                            } else {
                                new_fields.style.display = 'none';
                            }
                        });
                    </script>
                </form>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    
    <template id="registration_success" name="Registration Success">
        <t t-call="website.layout">
            <div class="container mt-4 text-center mb-4">
                <div class="alert alert-success">
                    <h2>Registration Successful!</h2>
                    <p>Your child <strong><t t-esc="student.name"/></strong> has been successfully registered for <strong><t t-esc="course.name"/></strong>.</p>
                    <p><strong>Assigned Center:</strong> <t t-esc="course.center_id.name"/></p>
                </div>
                <div class="mt-4">
                    <h4>Student Badge</h4>
                    <p>Please download this Code. It will be used for attendance tracking.</p>
                    <img t-attf-src="/report/barcode/?barcode_type=Code128&amp;value=#{student.qr_code}&amp;width=400&amp;height=100" alt="Student Badge Barcode" class="img-thumbnail mb-3"/>
                    <br/>
                    <a t-attf-href="/report/barcode/?barcode_type=Code128&amp;value=#{student.qr_code}&amp;width=600&amp;height=150" download="Student_Badge.png" class="btn btn-primary btn-lg mb-4">
                        <i class="fa fa-download"></i> Download Badge
                    </a>
                    
                    <h4>Next Steps</h4>
                    <p>Now that your child is successfully registered, you can track their attendance and academic challenge progress seamlessly from your portal.</p>
                    <a t-attf-href="/my/students" class="btn btn-secondary mt-3">
                        <i class="fa fa-dashboard"></i> Go to Student Tracker Portal
                    </a>
                </div>
            </div>
        </t>
    </template>
    <template id="portal_my_students" name="My Children Portal">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-5 mb-5">
                <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
                    <h4 class="m-0">Wallet Balance / رصيد المحفظة</h4>
                    <h4 class="m-0 font-weight-bold"><t t-esc="request.env.user.partner_id.wallet_balance"/> DZD</h4>
                </div>
                <h2 class="mb-4">My Profiles / Children</h2>
                <div class="row">
                    <t t-foreach="students" t-as="student">
                        <div class="col-md-4 mb-4">
                            <div class="card shadow-sm border-0">
                                <div class="card-body bg-light text-center">
                                    <h4 class="card-title text-primary"><t t-esc="student.name"/></h4>
                                    <a t-attf-href="/my/students/#{student.id}" class="btn btn-outline-primary w-100 mt-3">View Tracking Dashboard</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    
    <template id="portal_my_student_detail" name="Student Tracker Dashboard">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-5 mb-5">
                <a href="/my/students" class="btn btn-secondary mb-4"><i class="fa fa-arrow-left"/> Back to Profiles</a>
                
                <h2 class="mb-4">Courses for: <span class="text-primary"><t t-esc="student.name"/></span></h2>
                
                <t t-if="not registrations">
                    <div class="alert alert-warning">
                        No active course registrations found for this student.
                    </div>
                </t>
                
                <div class="row">
                    <t t-foreach="registrations" t-as="reg">
                        <div class="col-md-4 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body bg-light text-center">
                                    <h4 class="card-title text-success"><t t-esc="reg.course_id.name"/></h4>
                                    <p class="text-muted"><t t-esc="reg.course_id.center_id.name"/></p>
                                    <a t-attf-href="/my/students/#{student.id}/course/#{reg.id}" class="btn btn-outline-success w-100 mt-3">View Progress</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    
    <template id="portal_student_course_detail" name="Course Tracker Dashboard">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-5 mb-5">
                <a t-attf-href="/my/students/#{student.id}" class="btn btn-secondary mb-4"><i class="fa fa-arrow-left"/> Back to Courses</a>
                
                <h2 class="mb-4"><span class="text-primary"><t t-esc="student.name"/></span> - <span class="text-success"><t t-esc="registration.course_id.name"/></span> Tracker</h2>
                
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body bg-light">
                        <!-- Challenge Tracker -->
                        <h5 class="text-secondary mt-2"><i class="fa fa-trophy"/> Competency Challenges</h5>
                        <t t-set="challenges" t-value="request.env['school.student.challenge'].sudo().search([('registration_id', '=', registration.id)])"/>
                        <t t-if="challenges">
                            <ul class="list-group mb-4">
                                <t t-foreach="challenges" t-as="chal">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><t t-esc="chal.name"/></span>
                                        <span t-attf-class="badge rounded-pill #{'bg-success' if chal.state == 'passed' else 'bg-warning text-dark'}">
                                            <t t-if="chal.state == 'passed'">Passed <i class="fa fa-check"/></t>
                                            <t t-else="">Ongoing / Try Again</t>
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </t>
                        <t t-else="">
                            <p class="text-muted fst-italic">No challenges tracked yet for this course.</p>
                        </t>
                        
                        <!-- Session Reports -->
                        <h5 class="text-secondary mt-4"><i class="fa fa-file-text-o"/> Class Session Reports</h5>
                        <t t-set="sessions" t-value="request.env['school.course.session'].sudo().search([('course_id', '=', registration.course_id.id)], order='date desc')"/>
                        <t t-if="sessions">
                            <div t-foreach="sessions" t-as="sess" class="mb-3 border p-3 rounded bg-white">
                                <strong><t t-esc="sess.date"/> - <t t-esc="sess.name"/></strong>
                                <div class="mt-2 text-muted">
                                    <t t-raw="sess.report"/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted fst-italic">No session reports available yet.</p>
                        </t>
                        
                        <!-- Attendance log -->
                        <h5 class="text-secondary"><i class="fa fa-calendar"/> Recent Attendance</h5>
                        <t t-set="attendances" t-value="request.env['school.attendance'].sudo().search([('student_id', '=', student.id), ('course_id', '=', registration.course_id.id)], order='date desc')"/>
                        <t t-if="attendances">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover bg-white mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="attendances" t-as="att">
                                            <td><t t-esc="att.date"/></td>
                                            <td>
                                                <span t-attf-class="badge #{'bg-success' if att.state == 'present' else ('bg-danger' if att.state == 'absent' else 'bg-secondary')}">
                                                    <t t-esc="dict(att._fields['state'].selection).get(att.state)"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted fst-italic">No attendance records found for this course.</p>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    <template id="portal_blocked_unpaid" name="Portal Blocked">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-5 mb-5 text-center">
                <div class="alert alert-warning p-5 shadow-sm border-0">
                    <h1 class="display-4 text-warning mb-4"><i class="fa fa-lock"/> Access Restricted</h1>
                    <h3>Your portal is currently locked.</h3>
                    <p class="lead mt-3 text-muted">You must have at least one active, <strong>Paid</strong> course registration to access the children tracker portal.</p>
                    <a href="/services" class="btn btn-primary btn-lg mt-4 px-5">Browse Courses</a>
                </div>
            </div>
        </t>
    </template>
    
    <template id="attendance_scanner" name="Attendance Barcode Scanner">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-5 mb-5 text-center">
                <h2><i class="fa fa-barcode"></i> Scan Barcode to Mark Attendance</h2>
                <div class="row justify-content-center mt-4">
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label><strong>Select Course:</strong></label>
                            <select id="scanner_course" class="form-control form-control-lg">
                                <t t-foreach="courses" t-as="c">
                                    <option t-att-value="c.id"><t t-esc="c.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="form-group mb-4">
                            <input type="text" id="barcode_input" class="form-control form-control-lg text-center" placeholder="Click here and scan barcode... (or type and press Enter)" autofocus="1"/>
                        </div>
                        <div id="scanner_feedback" class="alert d-none mt-3"></div>
                    </div>
                </div>
            </div>
            
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function() {
                    var input = document.getElementById('barcode_input');
                    var feedback = document.getElementById('scanner_feedback');
                    var course_select = document.getElementById('scanner_course');
                    
                    input.addEventListener("keydown", function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            var code = input.value.trim();
                            if(code === '') return;
                            
                            var course_id = course_select.value;
                            
                            fetch('/school/attendance/scan_process', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    jsonrpc: "2.0",
                                    method: "call",
                                    params: {
                                        barcode: code,
                                        course_id: course_id
                                    }
                                })
                            })
                            .then(response => response.json())
                            .then(data => {
                                input.value = '';
                                input.focus();
                                feedback.classList.remove('d-none', 'alert-success', 'alert-danger');
                                if (data.result &amp;&amp; data.result.success) {
                                    feedback.classList.add('alert-success');
                                    feedback.innerText = data.result.success;
                                } else {
                                    feedback.classList.add('alert-danger');
                                    feedback.innerText = (data.result &amp;&amp; data.result.error) ? data.result.error : 'Scan Failed.';
                                }
                            });
                        }
                    });
                });
            </script>
        </t>
    </template>
</odoo>
