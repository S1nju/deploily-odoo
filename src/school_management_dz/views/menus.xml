<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to open barcode scanner in new tab -->
    <record id="action_open_scanner" model="ir.actions.act_url">
        <field name="name">Open Barcode Scanner</field>
        <field name="url">/school/attendance/scanner</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_school_management_root" name="School Management" sequence="50" web_icon="school_management,static/description/icon.png"/>
    
    <!-- Top-level Menus -->
    <menuitem id="menu_school_students_top" name="Students" parent="menu_school_management_root" sequence="10"/>
    <menuitem id="menu_school_courses_top" name="Courses" parent="menu_school_management_root" sequence="20"/>
    <menuitem id="menu_school_payments_top" name="Payments" parent="menu_school_management_root" sequence="30" action="action_school_payment"/>
    
    <menuitem id="menu_school_configuration" name="Configuration" parent="menu_school_management_root" sequence="40"/>

    <!-- Students submenu -->
    <menuitem id="menu_school_student" name="Students" parent="menu_school_students_top" sequence="10" action="action_school_student"/>
    <menuitem id="menu_school_attendance" name="Attendance Tracker" parent="menu_school_students_top" sequence="20" action="action_school_attendance_tracker"/>
    <menuitem id="menu_school_registration" name="Registrations" parent="menu_school_students_top" sequence="30" action="action_school_registration"/>

    <!-- Courses submenu -->
    <menuitem id="menu_school_course" name="Courses" parent="menu_school_courses_top" sequence="10" action="action_school_course"/>
    <menuitem id="menu_school_test" name="Assessments" parent="menu_school_courses_top" sequence="20" action="action_school_test"/>

    <!-- Configuration submenu -->
    <menuitem id="menu_school_service_category" name="Categories" parent="menu_school_configuration" sequence="10" action="action_school_service_category"/>
</odoo>
