<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_registration_form" model="ir.ui.view">
        <field name="name">school.registration.form</field>
        <field name="model">school.registration</field>
        <field name="arch" type="xml">
            <form string="Registration">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="course_id"/>
                        <field name="center_id" readonly="1"/>
                        <field name="crm_lead_id"/>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids" domain="[('parent_id', '=', parent_id)]"/>
                        </page>
                        <page string="Student Grades &amp; Info">
                            <group>
                                <field name="grades_filename" invisible="1"/>
                                <field name="grades_file" filename="grades_filename" widget="binary"/>
                            </group>
                        </page>
                        <page string="Test Answers">
                            <field name="test_answers" widget="text"/>
                        </page>
                        <page string="Competency Challenges">
                            <field name="challenge_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="date_evaluated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_registration_tree" model="ir.ui.view">
        <field name="name">school.registration.tree</field>
        <field name="model">school.registration</field>
        <field name="arch" type="xml">
            <list string="Registrations">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="course_id"/>
                <field name="center_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_school_registration_search" model="ir.ui.view">
        <field name="name">school.registration.search</field>
        <field name="model">school.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="course_id"/>
                <field name="center_id"/>
                <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Course" name="group_course" context="{'group_by':'course_id'}"/>
                <filter string="Center" name="group_center" context="{'group_by':'center_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_registration" model="ir.actions.act_window">
        <field name="name">Registrations</field>
        <field name="res_model">school.registration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
