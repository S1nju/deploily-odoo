<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_course_form" model="ir.ui.view">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <group>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Course Name"/></h1>
                    </div>
                    </group>
                    <group>
                        <field name="category_id"/>
                        <field name="subcategory_id"/>
                    </group>
                    <group>
                        <group>
                            <field name="tutor_id"/>
                            <field name="center_id"/>
                            <field name="location" placeholder="e.g. Online or Room 3"/>
                            <field name="hourly_price"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Information">
                            <field name="description"/>
                        </page>
                        <page string="Schedules">
                            <field name="schedule_ids">
                                <list editable="bottom">
                                    <field name="weekday"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sessions / Reports">
                            <field name="session_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                </list>
                                <form>
                                    <sheet>
                                        <div class="oe_title">
                                            <h1><field name="name" placeholder="E.g., Lesson 4 - Math"/></h1>
                                        </div>
                                        <group>
                                            <group string="Basic Information">
                                                <field name="date"/>
                                            </group>
                                            <group string="General Evaluation (Internal)">
                                                <field name="door_opened_on_time"/>
                                                <field name="room_tidy"/>
                                            </group>
                                            <group>
                                                <field name="class_type"/>
                                                <field name="execution_percentage"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Challenges Faced (Internal)">
                                                <group>
                                                    <group>
                                                        <field name="ch_time"/>
                                                        <field name="ch_resources"/>
                                                        <field name="ch_tech"/>
                                                    </group>
                                                    <group>
                                                        <field name="ch_subject"/>
                                                        <field name="ch_levels"/>
                                                        <field name="ch_crowd"/>
                                                    </group>
                                                    <group>
                                                        <field name="ch_interaction"/>
                                                        <field name="ch_discipline"/>
                                                        <field name="ch_late"/>
                                                    </group>
                                                    <group>
                                                        <field name="ch_focus"/>
                                                        <field name="ch_prep"/>
                                                        <field name="ch_none"/>
                                                    </group>
                                                </group>
                                                <group>
                                                    <field name="ch_other" placeholder="أخرى..."/>
                                                </group>
                                            </page>
                                            <page string="Public Report Content">
                                                <field name="report" placeholder="Write the report that parents will see here..."/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_course_tree" model="ir.ui.view">
        <field name="name">school.course.tree</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="category_id"/>
                <field name="tutor_id"/>
                <field name="start_date"/>
            </list>
        </field>
    </record>

    <record id="view_school_course_search" model="ir.ui.view">
        <field name="name">school.course.search</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tutor_id"/>
                <field name="center_id"/>
                <field name="subcategory_id"/>
                <filter string="Center" name="group_center" context="{'group_by':'center_id'}"/>
                <filter string="Subcategory" name="group_subcategory" context="{'group_by':'subcategory_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_school_service_category_tree" model="ir.ui.view">
        <field name="name">school.service.category.tree</field>
        <field name="model">school.service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    
    <record id="view_school_service_category_form" model="ir.ui.view">
        <field name="name">school.service.category.form</field>
        <field name="model">school.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <field name="subcategory_ids">
                        <list editable="bottom">
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_service_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">school.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_school_center_tree" model="ir.ui.view">
        <field name="name">school.center.tree</field>
        <field name="model">school.center</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="address"/>
            </list>
        </field>
    </record>
    
    <record id="view_school_center_form" model="ir.ui.view">
        <field name="name">school.center.form</field>
        <field name="model">school.center</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_center" model="ir.actions.act_window">
        <field name="name">Centers</field>
        <field name="res_model">school.center</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

