<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_course_form" model="ir.ui.view">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="subcategory_id"/>
                    </group>
                    <group>
                        <group>
                            <field name="tutor_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_course_tree" model="ir.ui.view">
        <field name="name">school.course.tree</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="category_id"/>
                <field name="tutor_id"/>
                <field name="start_date"/>
            </list>
        </field>
    </record>

    <record id="action_school_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_school_service_category_tree" model="ir.ui.view">
        <field name="name">school.service.category.tree</field>
        <field name="model">school.service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    
    <record id="view_school_service_category_form" model="ir.ui.view">
        <field name="name">school.service.category.form</field>
        <field name="model">school.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <field name="subcategory_ids">
                        <list editable="bottom">
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_service_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">school.service.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

