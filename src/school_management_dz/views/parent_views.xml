<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_school_tree" model="ir.ui.view">
        <field name="name">res.partner.school.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Parents" decoration-danger="wallet_balance &lt; 0">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="parent_activity"/>
                <field name="wallet_balance"/>
            </list>
        </field>
    </record>

    <record id="view_partner_form_inherit_school" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.school</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="School Management">
                    <group>
                        <group string="Basic Info (Arabic)">
                            <field name="custom_first_name"/>
                            <field name="custom_last_name"/>
                            <field name="father_name"/>
                            <field name="state_id" placeholder="الولاية..."/>
                            <field name="commune_id" placeholder="البلدية..."/>
                            <field name="neighborhood_name"/>
                        </group>
                        <group string="Activity &amp; Participation">
                            <field name="parent_activity"/>
                            <field name="mahara_participation"/>
                            <field name="is_parent_form_filled" readonly="1"/>
                        </group>
                    </group>
                    <group string="Messaging Platforms" col="4">
                        <field name="is_whatsapp"/>
                        <field name="is_telegram"/>
                        <field name="is_viber"/>
                    </group>
                    <field name="student_ids"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
