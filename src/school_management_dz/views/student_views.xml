<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(school_management_dz.action_student_attendance_calendar)d" type="action" class="oe_stat_button" icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Attendance</span>
                            </div>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Student's Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                    </group>
                    <notebook>
                        <page string="Registrations">
                            <field name="registration_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Student -->
    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="center_ids"/>
                <group expand="0" string="Group By">
                    <filter string="Center" name="group_center" context="{'group_by':'center_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.tree</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list string="Students" decoration-danger="wallet_balance &lt; 0">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="center_ids" widget="many2many_tags"/>
                <field name="wallet_balance"/>
            </list>
        </field>
    </record>

    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

