<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Report Action -->
        <record id="action_report_ordre_mission" model="ir.actions.report">
            <field name="name">Ordre de Mission</field>
            <field name="model">hr.mession</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_mission.report_ordre_mission_document</field>
            <field name="report_file">hr_mission.report_ordre_mission_document</field>
            <field name="binding_model_id" ref="model_hr_mession"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Ordre de Mission - %s' % (object.name)</field>
        </record>

        <!-- Report Template -->
        <template id="report_ordre_mission_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: Arial, sans-serif; direction: rtl; text-align: right;">
                            <!-- Header with Arabic and French -->
                            <div class="text-center mb-3" style="border-bottom: 2px solid #000; padding-bottom: 10px; direction: ltr;">
                                <h3 style="margin: 0; padding: 5px; direction: rtl;">تكليف بمهمة</h3>
                                <h3 style="margin: 0; padding: 5px; direction: ltr;">Ordre de Mission</h3>
                                <p style="margin-top: 10px; direction: rtl;">
                                    <strong>رقم : <span t-esc="o.id"/> / <span t-esc="o.mission_start_date.year if o.mission_start_date else '2025'"/></strong>
                                </p>
                            </div>

                            <!-- Mission Body -->
                            <div style="line-height: 2.5; margin-top: 30px; font-size: 14px; direction: rtl; text-align: right;">
                                <p style="margin-bottom: 15px;">
                                    يتعين على السيد(ة): <strong><u><span t-field="o.employee_id.name" style="padding: 0 20px;"/></u></strong>
                                </p>
                                
                                <p style="margin-bottom: 15px;">
                                    المولود(ة) في: <u style="padding: 0 20px;"><span t-field="o.employee_id.birthday" t-if="o.employee_id.birthday"/><span t-if="not o.employee_id.birthday">............</span></u> 
                                    بـ: <u style="padding: 0 20px;"><span t-field="o.employee_id.place_of_birth" t-if="o.employee_id.place_of_birth"/><span t-if="not o.employee_id.place_of_birth">............</span></u>
                                </p>
                                
                                <p style="margin-bottom: 15px;">
                                    المهنة: <u><span t-field="o.employee_id.job_id.name" style="padding: 0 50px;"/></u>
                                </p>
                                
                                <p style="margin-bottom: 15px;">
                                    بالإتجاه إلى: <strong><u><span t-field="o.destination" style="padding: 0 30px;"/></u></strong>
                                </p>
                                
                                <p style="margin-bottom: 15px;">
                                    لأداء مهمة: <strong><u><span t-field="o.name" style="padding: 0 30px;"/></u></strong>
                                </p>
                                
                                <p style="margin-bottom: 15px;">
                                    مستعملا وسيلة النقل: 
                                    <u style="padding: 0 20px;">
                                        <span t-if="o.mission_car == 'pc'">سيارة شخصية / Voiture personnelle</span>
                                        <span t-if="o.mission_car == 'cc'">سيارة الخدمة / Voiture de service</span>
                                        <span t-if="o.mission_car == 'plane'">طائرة / Avion</span>
                                        <span t-if="o.mission_car == 'boat'">سفينة / Bateau</span>
                                        <span t-if="o.mission_car == 'other'">أخرى / Autre</span>
                                        <span t-if="not o.mission_car">كل الوسائل / Tous les moyens</span>
                                    </u>
                                </p>
                                
                                <p style="margin-bottom: 15px;">
                                    لمدة <u style="padding: 0 10px;"><span t-esc="o.mission_duration or '....'"/></u> حيث تنطلق يوم: 
                                    <u style="padding: 0 20px;"><span t-field="o.mission_start_date" t-options="{'format': 'dd/MM/yyyy'}"/></u>
                                </p>
                                
                                <p style="margin-bottom: 15px;">
                                    من: <u style="padding: 0 30px;"><span t-field="o.mission_start_date" t-options="{'widget': 'datetime', 'format': 'HH:mm'}"/></u>
                                    والعودة يوم: <u style="padding: 0 30px;"><span t-field="o.mission_end_date" t-options="{'format': 'dd/MM/yyyy'}"/></u>
                                </p>
                                
                                <p style="margin-top: 30px;">
                                    لاستغلالها حسب ما يسمح به القانون
                                </p>
                            </div>

                            <!-- Date and Signature Section -->
                            <div style="margin-top: 40px; margin-bottom: 40px; direction: rtl; text-align: right;">
                                <p>
                                    حرر بـ<span t-field="o.employee_id.company_id.city" t-if="o.employee_id.company_id.city"/><span t-if="not o.employee_id.company_id.city">................</span>، في <u style="padding: 0 30px;"><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></u>
                                </p>
                                <p style="text-align: center; margin-top: 60px;">
                                    <strong>خاتم وإمضاء المسير</strong>
                                </p>
                            </div>

                            <!-- Page Break for second page -->
                            <div style="page-break-before: always;"></div>

                            <!-- Expense Declaration Section -->
                            <div style="margin-top: 20px; direction: rtl; text-align: right;">
                                <div class="text-center" style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 30px;">
                                    <h4 style="margin: 5px;">التصريح بتكاليف المهمة</h4>
                                    <h4 style="margin: 5px;">Déclaration des frais de mission</h4>
                                </div>

                                <!-- Expenses Table -->
                                <table style="width: 100%; border-collapse: collapse; margin-top: 20px; direction: rtl;" class="table table-bordered">
                                    <thead>
                                        <tr style="background-color: #f0f0f0;">
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 25%;">
                                                تعيين المنحة التعويضية<br/>Désignation de l'indemnité
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 12%;">
                                                قيمة المنحة<br/>Valeur unitaire
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 10%;">
                                                العملة<br/>Devise
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 12%;">
                                                عدد الأيام<br/>Nombre de jours
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 13%;">
                                                المبلغ الكلي<br/>Montant total
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 28%;">
                                                الملاحظات<br/>Observations
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Loop through mission fees -->
                                        <tr t-foreach="o.fee_ids" t-as="fee">
                                            <td style="border: 1px solid #000; padding: 8px; height: 40px; text-align: right;">
                                                <span t-field="fee.designation"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                <span t-field="fee.unit_value"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                <span t-field="fee.currency_id.name"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                <span t-field="fee.number_of_days"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                <span t-field="fee.total_amount"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                                <span t-field="fee.observations"/>
                                            </td>
                                        </tr>
                                        <!-- Empty rows if no fees -->
                                        <tr t-if="not o.fee_ids">
                                            <td style="border: 1px solid #000; padding: 8px; height: 40px; text-align: center;">............</td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">............</td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">............</td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">............</td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">............</td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">............</td>
                                        </tr>
                                        <!-- Total row -->
                                        <tr style="font-weight: bold;">
                                            <td colspan="4" style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                المجموع / Total
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                <span t-field="o.fee_amount"/> DZD
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">............</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Additional Information -->
                                <div style="margin-top: 30px; direction: rtl; text-align: right;">
                                    <p>
                                        <span t-field="o.employee_id.company_id.city" t-if="o.employee_id.company_id.city"/><span t-if="not o.employee_id.company_id.city">................</span> في: <u style="padding: 0 30px;">................................</u>
                                    </p>
                                </div>

                                <div style="margin-top: 20px; direction: rtl; text-align: right;">
                                    <p>
                                        ملاحظات: <u style="padding: 0 10px;"><span t-field="o.mission_notes" style="white-space: pre-wrap;"/></u>
                                    </p>
                                </div>

                                <div style="margin-top: 20px; direction: rtl; text-align: right;">
                                    <p>
                                        تاريخ الذهاب: <u style="padding: 0 20px;"><span t-field="o.mession_real_start_date" t-options="{'format': 'dd/MM/yyyy'}"/></u>
                                        تاريخ العودة: <u style="padding: 0 20px;"><span t-field="o.mession_real_end_date" t-options="{'format': 'dd/MM/yyyy'}"/></u>
                                    </p>
                                </div>

                                <!-- Signatures -->
                                <div style="margin-top: 60px; direction: rtl;">
                                    <table style="width: 100%; text-align: center;">
                                        <tr>
                                            <td style="width: 33%;">
                                                <p><strong>المعني</strong></p>
                                                <p style="margin-top: 60px;">........................</p>
                                            </td>
                                            <td style="width: 34%;">
                                                <p><strong>مسؤول الإدارة و المالية</strong></p>
                                                <p style="margin-top: 60px;">........................</p>
                                            </td>
                                            <td style="width: 33%;">
                                                <p><strong>خاتم وإمضاء المسير</strong></p>
                                                <p style="margin-top: 60px;">........................</p>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
