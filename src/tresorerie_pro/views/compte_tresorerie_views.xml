<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_compte_tresorerie_list" model="ir.ui.view">
      <field name="name">compte.tresorerie.list</field>
      <field name="model">compte.tresorerie</field>
      <field name="arch" type="xml">
        <list string="Comptes de trésorerie" editable="bottom">
          <field name="sequence" widget="handle"/>
          <field name="name"/>
          <field name="solde_initial"       widget="monetary" string="Solde initial"/>
          <field name="solde_previsionnel"  widget="monetary" string="Solde prévisionnel"/>
          <field name="journal_id"          domain="[('type', 'in', ['bank', 'cash'])]" optional="show"/>
          <field name="solde_reel"          widget="monetary" optional="show"/>
          <field name="currency_id"         column_invisible="1"/>
          <button name="action_voir_flux"   type="object" icon="fa-list" title="Voir les flux"/>
        </list>
      </field>
    </record>

    <record id="view_compte_tresorerie_form" model="ir.ui.view">
      <field name="name">compte.tresorerie.form</field>
      <field name="model">compte.tresorerie</field>
      <field name="arch" type="xml">
        <form string="Compte de trésorerie">
          <sheet>
            <div class="oe_title">
              <h1><field name="name" placeholder="Nom du compte..."/></h1>
            </div>
            <group>
              <group string="Configuration">
                <field name="journal_id" domain="[('type', 'in', ['bank', 'cash'])]"/>
                <field name="type_journal" readonly="1"/>
                <field name="company_id"   readonly="1"/>
                <field name="sequence"/>
              </group>
              <group string="Soldes">
                <field name="solde_initial"      widget="monetary"/>
                <field name="solde_previsionnel" widget="monetary" readonly="1"/>
                <field name="solde_reel"         widget="monetary" readonly="1"/>
                <field name="currency_id"        invisible="1"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_compte_tresorerie" model="ir.actions.act_window">
      <field name="name">Comptes de trésorerie</field>
      <field name="res_model">compte.tresorerie</field>
      <field name="view_mode">list,form</field>
    </record>

  </data>
</odoo>
