<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_fiche_paie_template">
<t t-call="web.html_container">
<t t-foreach="docs" t-as="slip">
<t t-call="web.external_layout">
<div class="page">
    <style>
        .paie-header { background: #2c3e50; color: white; padding: 15px; margin-bottom: 20px; }
        .paie-title { font-size: 22px; font-weight: bold; text-align: center; }
        .paie-subtitle { font-size: 14px; text-align: center; }
        .info-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
        .info-table td { padding: 6px 10px; border: 1px solid #ddd; font-size: 12px; }
        .info-table th { background: #34495e; color: white; padding: 8px 10px; font-size: 12px; }
        .rubrique-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
        .rubrique-table th { background: #2980b9; color: white; padding: 8px; font-size: 11px; text-align: left; }
        .rubrique-table td { padding: 6px 8px; border-bottom: 1px solid #eee; font-size: 11px; }
        .rubrique-table tr:nth-child(even) { background: #f8f9fa; }
        .totals-box { background: #2c3e50; color: white; padding: 15px; margin-top: 15px; }
        .totals-row { display: flex; justify-content: space-between; margin-bottom: 5px; }
        .net-payer { font-size: 18px; font-weight: bold; border-top: 2px solid white; margin-top: 10px; padding-top: 10px; }
        .section-title { background: #ecf0f1; padding: 5px 10px; font-weight: bold; font-size: 12px; margin: 10px 0 5px 0; }
        .positive { color: #27ae60; }
        .negative { color: #e74c3c; }
    </style>

    <!-- EN-TETE -->
    <div class="paie-header">
        <div class="paie-title">BULLETIN DE PAIE</div>
        <div class="paie-subtitle">
            Periode: <t t-esc="slip.date_from.strftime('%B %Y')"/>
        </div>
    </div>

    <!-- INFO EMPLOYE ET SOCIETE -->
    <table class="info-table">
        <tr>
            <th colspan="2">Informations Employe</th>
            <th colspan="2">Informations Societe</th>
        </tr>
        <tr>
            <td><b>Nom et Prenom:</b></td>
            <td><t t-esc="slip.employee_id.name"/></td>
            <td><b>Societe:</b></td>
            <td><t t-esc="slip.company_id.name"/></td>
        </tr>
        <tr>
            <td><b>Matricule:</b></td>
            <td><t t-esc="slip.contract_id.matricule or '-'"/></td>
            <td><b>Adresse:</b></td>
            <td><t t-esc="slip.company_id.street or '-'"/></td>
        </tr>
        <tr>
            <td><b>Poste:</b></td>
            <td><t t-esc="slip.contract_id.job_id.name or '-'"/></td>
            <td><b>NIF:</b></td>
            <td><t t-esc="slip.company_id.vat or '-'"/></td>
        </tr>
        <tr>
            <td><b>N° CNAS:</b></td>
            <td><t t-esc="slip.contract_id.numero_cnas or '-'"/></td>
            <td><b>Periode:</b></td>
            <td>
                Du <t t-esc="slip.date_from.strftime('%d/%m/%Y')"/>
                au <t t-esc="slip.date_to.strftime('%d/%m/%Y')"/>
            </td>
        </tr>
        <tr>
            <td><b>Grade:</b></td>
            <td><t t-esc="slip.contract_id.grade or '-'"/></td>
            <td><b>Date paiement:</b></td>
            <td><t t-esc="slip.date_to.strftime('%d/%m/%Y')"/></td>
        </tr>
        <tr>
            <td><b>Anciennete:</b></td>
            <td><t t-esc="slip.compute_anciennete()"/> ans</td>
            <td><b>Moyen paiement:</b></td>
            <td><t t-esc="dict(slip._fields['moyen_paiement'].selection).get(slip.moyen_paiement, '-')"/></td>
        </tr>
    </table>

    <!-- RUBRIQUES DE GAINS -->
    <div class="section-title">ELEMENTS DE REMUNERATION (GAINS)</div>
    <table class="rubrique-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Designation</th>
                <th style="text-align:right">Montant (DA)</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="slip.line_ids.filtered(lambda l: l.total > 0 and l.appears_on_payslip and l.code not in ['BRUT', 'NET', 'CNAS_PAT', 'SU'])" t-as="line">
            <tr>
                <td><t t-esc="line.code"/></td>
                <td><t t-esc="line.name"/></td>
                <td style="text-align:right" class="positive">
                    <t t-esc="'{:,.2f}'.format(line.total)"/>
                </td>
            </tr>
            </t>
        </tbody>
    </table>

    <!-- RUBRIQUES DE RETENUES -->
    <div class="section-title">RETENUES ET COTISATIONS</div>
    <table class="rubrique-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Designation</th>
                <th style="text-align:right">Montant (DA)</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="slip.line_ids.filtered(lambda l: l.total &lt; 0 and l.appears_on_payslip)" t-as="line">
            <tr>
                <td><t t-esc="line.code"/></td>
                <td><t t-esc="line.name"/></td>
                <td style="text-align:right" class="negative">
                    <t t-esc="'{:,.2f}'.format(abs(line.total))"/>
                </td>
            </tr>
            </t>
        </tbody>
    </table>

    <!-- TOTAUX -->
    <div class="totals-box">
        <div class="totals-row">
            <span>Salaire Brut:</span>
            <span><t t-esc="'{:,.2f}'.format(slip.montant_brut)"/> DA</span>
        </div>
        <div class="totals-row">
            <span>CNAS Salariale (9%):</span>
            <span>- <t t-esc="'{:,.2f}'.format(slip.cotisation_cnas_salariale)"/> DA</span>
        </div>
        <div class="totals-row">
            <span>IRG:</span>
            <span>- <t t-esc="'{:,.2f}'.format(slip.montant_irg)"/> DA</span>
        </div>
        <div class="totals-row net-payer">
            <span>NET A PAYER:</span>
            <span><t t-esc="'{:,.2f}'.format(slip.net_a_payer)"/> DA</span>
        </div>
    </div>

    <!-- CHARGE PATRONALE -->
    <table class="info-table" style="margin-top:15px">
        <tr>
            <th colspan="2">Charges Patronales (information)</th>
        </tr>
        <tr>
            <td><b>CNAS Patronale (26%):</b></td>
            <td><t t-esc="'{:,.2f}'.format(slip.cotisation_cnas_patronale)"/> DA</td>
        </tr>
        <tr>
            <td><b>Cout total employe:</b></td>
            <td><t t-esc="'{:,.2f}'.format(slip.montant_brut + slip.cotisation_cnas_patronale)"/> DA</td>
        </tr>
    </table>

    <!-- SIGNATURE -->
    <div style="margin-top:40px; display:flex; justify-content:space-between;">
        <div style="text-align:center; width:45%;">
            <p><b>Signature Employe</b></p>
            <br/><br/>
            <p>___________________________</p>
        </div>
        <div style="text-align:center; width:45%;">
            <p><b>Signature Employeur</b></p>
            <br/><br/>
            <p>___________________________</p>
        </div>
    </div>

</div>
</t>
</t>
</t>
</template>
</odoo>
