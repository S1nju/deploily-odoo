<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- HR Employee Views (Inherited) -->
        <record model="ir.ui.view" id="view_hr_employee_form_inherit">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='work_phone']" position="after">
                    <field name="ss_number"/>
                    <field name="ccp_number"/>
                    <field name="category"/>
                    <field name="iep_rate"/>
                </xpath>
            </field>
        </record>

        <!-- HR Employee Kanban View -->
        <record model="ir.ui.view" id="view_hr_employee_kanban_deploily">
            <field name="name">hr.employee.kanban.deploily</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_employee_kanban" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="work_email"/>
                    <field name="work_phone"/>
                    <field name="job_id"/>
                    <field name="department_id"/>
                    <field name="category"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('hr.employee', 'avatar_128', record.id.raw_value)}')">
                                    <img class="o_kanban_image_inner_pic" t-if="record.image_128.raw_value" t-att-alt="record.name.value" t-att-src="kanban_image('hr.employee', 'avatar_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details d-flex flex-column">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <ul>
                                        <li t-if="record.job_id.raw_value">
                                            <field name="job_id"/>
                                        </li>
                                        <li t-if="record.department_id.raw_value">
                                            <field name="department_id"/>
                                        </li>
                                        <li t-if="record.work_email.raw_value">
                                            <field name="work_email" widget="email"/>
                                        </li>
                                        <li t-if="record.work_phone.raw_value">
                                            <field name="work_phone"/>
                                        </li>
                                        <li t-if="record.category.raw_value">
                                            <field name="category"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- HR Employee Action -->
        <record model="ir.actions.act_window" id="action_hr_employee_deploily">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new employee
                </p>
                <p>
                    Create employee records with all required information.
                </p>
            </field>
        </record>
    </data>
</odoo>
