<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- HR Leave Views (Inherited) -->
        <record model="ir.ui.view" id="view_hr_leave_form_inherit">
            <field name="name">hr.leave.form.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
       
        </record>

        <!-- Action for All Time Off -->
        <record model="ir.actions.act_window" id="action_hr_leave_all">
            <field name="name">All Time Off</field>
            <field name="res_model">hr.leave</field>
            <field name="view_mode">list,form,calendar,activity</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new time off request
                </p>
                <p>
                    Manage all employee time off requests.
                </p>
            </field>
        </record>
    </data>
</odoo>
