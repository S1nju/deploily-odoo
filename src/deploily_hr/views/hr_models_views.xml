<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- HR Mission Scale Views -->
        <record model="ir.ui.view" id="view_hr_mission_scale_tree">
            <field name="name">hr.mession.scale.list</field>
            <field name="model">hr.mession.scale</field>
            <field name="arch" type="xml">
                <list string="Mission Scales" sample="1">
                    <field name="name"/>
                    <field name="mission_type"/>
                    <field name="daily_amount"/>
                    <field name="is_covered"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_mission_scale_form">
            <field name="name">hr.mession.scale.form</field>
            <field name="model">hr.mession.scale</field>
            <field name="arch" type="xml">
                <form string="Mission Scale">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="mission_type"/>
                            <field name="daily_amount"/>
                            <field name="is_covered"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_hr_mission_scale_view">
            <field name="name">Mission Scales</field>
            <field name="res_model">hr.mession.scale</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Mission Scale
                </p>
                <p>Define mission allowances for national and international assignments.</p>
            </field>
        </record>

        <!-- HR Education Views -->
        <record model="ir.ui.view" id="view_hr_education_tree">
            <field name="name">hr.education.list</field>
            <field name="model">hr.education</field>
            <field name="arch" type="xml">
                <list string="Education" sample="1">
                    <field name="employee_id"/>
                    <field name="diploma_type"/>
                    <field name="subject"/>
                    <field name="finish_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_education_form">
            <field name="name">hr.education.form</field>
            <field name="model">hr.education</field>
            <field name="arch" type="xml">
                <form string="Education">
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="diploma_type"/>
                            <field name="subject"/>
                            <field name="finish_date"/>
                            <field name="state"/>
                            <field name="attachment"/>
                            
                        </group>
                        
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_hr_education_view">
            <field name="name">Education</field>
            <field name="res_model">hr.education</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Education Record
                </p>
                <p>Manage employee diplomas and certifications.</p>
            </field>
        </record>

        <!-- HR Discipline Views -->
        <record model="ir.ui.view" id="view_hr_discipline_tree">
            <field name="name">hr.discipline.list</field>
            <field name="model">hr.discipline</field>
            <field name="arch" type="xml">
                <list string="Discipline" sample="1">
                    <field name="employee_id"/>
                    <field name="type_sanction"/>
                    <field name="date_incident"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_discipline_form">
            <field name="name">hr.discipline.form</field>
            <field name="model">hr.discipline</field>
            <field name="arch" type="xml">
                <form string="Discipline" >
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="type_sanction"/>
                            <field name="date_incident"/>
                            <field name="document_joint"/>
                            <field name="attachment2" widget="many2many_binary"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_hr_discipline_view">
            <field name="name">Discipline</field>
            <field name="res_model">hr.discipline</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Discipline Record
                </p>
                <p>Manage employee disciplinary records.</p>
            </field>
        </record>

        <!-- HR Evaluation Views -->
        <record model="ir.ui.view" id="view_hr_evaluation_tree">
            <field name="name">hr.evaluation.list</field>
            <field name="model">hr.evaluation</field>
            <field name="arch" type="xml">
                <list string="Evaluation" sample="1">
                    <field name="nom"/>
                    <field name="date_compagne"/>
                    <field name="employee_id"/>
                    <field name="evolution_type"/>
                </list>
            </field>
        </record>

<record id="view_hr_evaluation_form" model="ir.ui.view">
    <field name="name">hr.evaluation.form</field>
    <field name="model">hr.evaluation</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="nom"/>
                    <field name="employee_id"/>
                    <field name="date_compagne"/>
                    <field name="evolution_type"/>
                </group>
                <separator string="Critères de Performance"/>
                <field name="evaluation_line_ids">
                    <tree editable="bottom">
                     
                    </tree>
                </field>
            </sheet>
        </form>
    </field>
</record>
        <record model="ir.actions.act_window" id="action_hr_evaluation_view">
            <field name="name">Evaluation</field>
            <field name="res_model">hr.evaluation</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Evaluation Campaign
                </p>
                <p>Manage employee performance evaluations.</p>
            </field>
        </record>

        <!-- HR Medical Views -->
        <record model="ir.ui.view" id="view_hr_medical_tree">
            <field name="name">hr.medical.list</field>
            <field name="model">hr.medical</field>
            <field name="arch" type="xml">
                <list string="Medical Records" sample="1">
                    <field name="employee_id"/>
                    <field name="incident_type"/>
                    <field name="date_event"/>
                    <field name="is_covered"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_medical_form">
            <field name="name">hr.medical.form</field>
            <field name="model">hr.medical</field>
            <field name="arch" type="xml">
                <form string="Medical Record">
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="incident_type"/>
                            <field name="date_event"/>
                            <field name="is_covered"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_hr_medical_view">
            <field name="name">Medical Records</field>
            <field name="res_model">hr.medical</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Medical Record
                </p>
                <p>Track employee medical and social events.</p>
            </field>
        </record>

        <!-- HR Mission Views -->
        <record model="ir.ui.view" id="view_hr_mession_tree">
            <field name="name">hr.mession.list</field>
            <field name="model">hr.mession</field>
            <field name="arch" type="xml">
                <list string="Missions" sample="1">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="destination"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="mission_type"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_mession_form">
            <field name="name">hr.mession.form</field>
            <field name="model">hr.mession</field>
            <field name="arch" type="xml">
                <form string="Mission">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="employee_id"/>
                                <field name="destination"/>
                                <field name="mission_type"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="fee_amount"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_hr_mession_view">
            <field name="name">Missions</field>
            <field name="res_model">hr.mession</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Mission
                </p>
                <p>Manage employee missions and travel assignments.</p>
            </field>
        </record>

        <!-- HR Promotion Views -->
        <record model="ir.ui.view" id="view_hr_promotion_tree">
            <field name="name">hr.promotion.list</field>
            <field name="model">hr.promotion</field>
            <field name="arch" type="xml">
                <list string="Promotions" sample="1">
                    <field name="employee_id"/>
                    <field name="old_job_id"/>
                    <field name="new_job_id"/>
                    <field name="date_effective"/>
                    <field name="type_promotion"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_promotion_form">
            <field name="name">hr.promotion.form</field>
            <field name="model">hr.promotion</field>
            <field name="arch" type="xml">
                <form string="Promotion">
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="old_job_id"/>
                            <field name="new_job_id"/>
                            <field name="date_effective"/>
                            <field name="type_promotion"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_hr_promotion_view">
            <field name="name">Promotions</field>
            <field name="res_model">hr.promotion</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Promotion
                </p>
                <p>Track employee career progression and promotions.</p>
            </field>
        </record>

        <!-- HR Employee Views (Inherited) -->
        <record model="ir.ui.view" id="view_hr_employee_form_inherit">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='work_phone']" position="after">
                    <field name="ss_number"/>
                    <field name="ccp_number"/>
                    <field name="category"/>
                    <field name="iep_rate"/>
                </xpath>
            </field>
        </record>

        <!-- HR Employee Kanban View -->
        <record model="ir.ui.view" id="view_hr_employee_kanban_deploily">
            <field name="name">hr.employee.kanban.deploily</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_employee_kanban" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="work_email"/>
                    <field name="work_phone"/>
                    <field name="job_id"/>
                    <field name="department_id"/>
                    <field name="category"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('hr.employee', 'avatar_128', record.id.raw_value)}')">
                                    <img class="o_kanban_image_inner_pic" t-if="record.image_128.raw_value" t-att-alt="record.name.value" t-att-src="kanban_image('hr.employee', 'avatar_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details d-flex flex-column">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <ul>
                                        <li t-if="record.job_id.raw_value">
                                            <field name="job_id"/>
                                        </li>
                                        <li t-if="record.department_id.raw_value">
                                            <field name="department_id"/>
                                        </li>
                                        <li t-if="record.work_email.raw_value">
                                            <field name="work_email" widget="email"/>
                                        </li>
                                        <li t-if="record.work_phone.raw_value">
                                            <field name="work_phone"/>
                                        </li>
                                        <li t-if="record.category.raw_value">
                                            <field name="category"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- HR Employee Action -->
        <record model="ir.actions.act_window" id="action_hr_employee_deploily">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new employee
                </p>
                <p>
                    Create employee records with all required information.
                </p>
            </field>
        </record>

        <!-- HR Leave Views (Inherited) -->
        <record model="ir.ui.view" id="view_hr_leave_form_inherit">
            <field name="name">hr.leave.form.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='number_of_days']" position="after">
                    <field name="attachment_file"/>
                </xpath>
            </field>
        </record>

        <!-- MENU ITEMS -->
        <menuitem id="deploily_hr_menu_root" name="Deploily HR" sequence="10"/>
        
        <!-- Employee Menu -->
        <menuitem id="menu_hr_employee" 
                  name="Employee" 
                  parent="deploily_hr_menu_root" 
                  action="action_hr_employee_deploily" 
                  sequence="1"/>
        
        <!-- Time Off Menu -->
        <menuitem id="menu_hr_leave" 
                  name="Time Off" 
                  parent="deploily_hr_menu_root" 
                  action="hr_holidays.hr_leave_action_my" 
                  sequence="2"/>
        
        <!-- Medical Menu -->
        <menuitem id="menu_hr_medical" 
                  name="Medical Records" 
                  parent="deploily_hr_menu_root" 
                  action="action_hr_medical_view" 
                  sequence="5"/>
        
        <!-- Mission Scale Menu -->
        <menuitem id="menu_hr_mission_scale" 
                  name="Mission Scales" 
                  parent="deploily_hr_menu_root" 
                  action="action_hr_mission_scale_view" 
                  sequence="10"/>
        
        <!-- Mission Menu -->
        <menuitem id="menu_hr_mession" 
                  name="Missions" 
                  parent="deploily_hr_menu_root" 
                  action="action_hr_mession_view" 
                  sequence="15"/>
        
        <!-- Promotion Menu -->
        <menuitem id="menu_hr_promotion" 
                  name="Promotions" 
                  parent="deploily_hr_menu_root" 
                  action="action_hr_promotion_view" 
                  sequence="25"/>
        
        <!-- Discipline Menu -->
        <menuitem id="menu_hr_discipline" 
                  name="Discipline" 
                  parent="deploily_hr_menu_root" 
                  action="action_hr_discipline_view" 
                  sequence="30"/>
        
        <!-- Evaluation Menu -->
        <menuitem id="menu_hr_evaluation" 
                  name="Evaluation" 
                  parent="deploily_hr_menu_root" 
                  action="action_hr_evaluation_view" 
                  sequence="40"/>
    </data>
</odoo>
