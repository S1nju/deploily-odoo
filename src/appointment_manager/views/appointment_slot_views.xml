<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SLOT LIST VIEW -->
    <record id="appointment_slot_view_list" model="ir.ui.view">
        <field name="name">appointment.slot.view.list</field>
        <field name="model">appointment.slot</field>
        <field name="arch" type="xml">
            <list string="Disponibilités"
                  decoration-success="is_available == True"
                  decoration-danger="is_available == False"
                  editable="top">
                <field name="date"/>
                <field name="is_available" widget="boolean_toggle"/>
                <field name="appointment_count" string="Nb RDV"/>
                <field name="note"/>
                <button name="action_view_appointments" string="Voir RDV"
                        type="object" icon="fa-calendar"
                        invisible="appointment_count == 0"/>
            </list>
        </field>
    </record>

    <!-- SLOT FORM VIEW -->
    <record id="appointment_slot_view_form" model="ir.ui.view">
        <field name="name">appointment.slot.view.form</field>
        <field name="model">appointment.slot</field>
        <field name="arch" type="xml">
            <form string="Disponibilité">
                <header>
                    <button name="action_toggle_availability"
                            string="Changer disponibilité"
                            type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="is_available" widget="boolean_toggle"/>
                        <field name="note"/>
                        <field name="appointment_count" readonly="1"/>
                    </group>
                    <group string="Rendez-vous ce jour">
                        <field name="appointment_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="client_name"/>
                                <field name="client_phone"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_appointment_slot" model="ir.actions.act_window">
        <field name="name">Disponibilités</field>
        <field name="res_model">appointment.slot</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- CONFIG FORM VIEW -->
    <record id="appointment_config_view_form" model="ir.ui.view">
        <field name="name">appointment.config.view.form</field>
        <field name="model">appointment.config</field>
        <field name="arch" type="xml">
            <form string="Lien de réservation">
                <sheet>
                    <group string="Lien de réservation en ligne">
                        <field name="booking_link" widget="url" readonly="1"/>
                        <field name="booking_token" readonly="1"/>
                    </group>
                    <div class="alert alert-info">
                        <strong>📋 Comment utiliser :</strong> Copiez ce lien et envoyez-le à vos clients.
                        Ils pourront choisir une date et remplir le formulaire en ligne.
                        Le rendez-vous apparaîtra automatiquement dans votre calendrier et dans CRM.
                    </div>
                    <button name="action_regenerate_token" string="🔄 Régénérer le lien"
                            type="object" class="btn-secondary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_appointment_config" model="ir.actions.act_window">
        <field name="name">Lien de réservation</field>
        <field name="res_model">appointment.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
