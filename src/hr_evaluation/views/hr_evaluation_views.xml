<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


    

        <!-- HR Evaluation Views -->
        <record model="ir.ui.view" id="view_hr_evaluation_form">
            <field name="name">hr.evaluation.form</field>
            <field name="model">hr.evaluation</field>
            <field name="arch" type="xml">
                <form string="Evaluation">
                    <header>
                        <button name="action_submit" string="Submit" type="object" class="btn-primary"/>
                        <button name="action_review" string="Review" type="object" class="btn-primary"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="evaluator_id"/>
                            <field name="evaluation_date"/>
                            <field name="rating"/>
                        </group>
                        <field name="comments"/>
                        <field name="line_ids" widget="one2many_list">
                            <list>
                                <field name="criteria"/>
                                <field name="rating"/>
                                <field name="comment"/>
                            </list>
                        </field>
                  
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_evaluation_list">
            <field name="name">hr.evaluation.list</field>
            <field name="model">hr.evaluation</field>
            <field name="arch" type="xml">
                <list string="Evaluations">
                    <field name="employee_id"/>
                    <field name="evaluator_id"/>
                    <field name="evaluation_date"/>
                    <field name="rating"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- HR Evaluation Action -->
        <record model="ir.actions.act_window" id="action_hr_evaluation">
            <field name="name">Evaluations</field>
            <field name="res_model">hr.evaluation</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
