<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Vues Évaluation RH -->
        <record model="ir.ui.view" id="view_hr_evaluation_form">
            <field name="name">hr.evaluation.form</field>
            <field name="model">hr.evaluation</field>
            <field name="arch" type="xml">
                <form string="Évaluation">
                    <header>
                       <button
        name="action_submit"
        string="Soumettre"
        type="object"
        class="btn-primary"
        invisible="state != 'draft'"
    />

    <!-- Valider -->
    <button
        name="action_review"
        string="Valider"
        type="object"
        class="btn-primary"
        invisible="state != 'submitted'"
    />

    <!-- Archiver -->
    <button
        name="action_archive"
        string="Archiver"
        type="object"
        class="btn-secondary"
        invisible="state != 'reviewed'"
    />

    <!-- Retour brouillon -->
    <button
        name="action_reset_to_draft"
        string="Repasser en brouillon"
        type="object"
        class="btn-secondary"
        invisible="state not in ['submitted', 'reviewed', 'archived']"
    />

    <field name="state"
           widget="statusbar"
           statusbar_visible="draft,submitted,reviewed,archived"/>
                    </header>

                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="evaluator_id"/>
                            <field name="evaluation_date"/>
                            <field name="rating"/>
                        </group>

                        <field name="comments"/>

                        <field name="line_ids" widget="one2many_list" string="Critères d’évaluation">
                            <list>
                                <field name="criteria"/>
                                <field name="rating"/>
                                <field name="comment"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_hr_evaluation_list">
            <field name="name">hr.evaluation.list</field>
            <field name="model">hr.evaluation</field>
            <field name="arch" type="xml">
                <list string="Évaluations">
                    <field name="employee_id"/>
                    <field name="evaluator_id"/>
                    <field name="evaluation_date"/>
                    <field name="rating"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Action Évaluation RH -->
        <record model="ir.actions.act_window" id="action_hr_evaluation">
            <field name="name">Évaluations</field>
            <field name="res_model">hr.evaluation</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>