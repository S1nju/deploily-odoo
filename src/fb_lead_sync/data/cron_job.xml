<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_fb_lead_sync" model="ir.cron">
            <field name="name">Facebook Lead Ads: Daily Sync</field>
            <field name="model_id" ref="model_fb_lead_sync"/>
            <field name="state">code</field>
            <field name="code">model.sync_facebook_leads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
